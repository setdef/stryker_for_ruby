module Stryker
  module Mutators
    # A call written as a prefix operator before its receiver, such as `!x`,
    # `not x`, or `-x`, and not as a method call, such as `x.!` or `x.-@`.
    #
    # ## Examples
    #
    # The edits that a table makes of `!x`, which drops the operator:
    #
    # ```ruby
    # call = Prism.parse("!x").value.statements.body.first
    # Stryker::Mutators::Prefix.edits(call, { "!": [nil] }) { false }
    # # => [#<data Stryker::Edit start_offset=0, end_offset=2, replacement="x">]
    # ```
    class Prefix < Data
      # The call.
      attr_reader call: Prism::CallNode

      # The call's receiver: the operand.
      attr_reader receiver: Prism::node

      # Where the operator is written.
      attr_reader operator_loc: Prism::Location

      # Builds the prefix.
      #
      # - `call`: Prism::CallNode, the call.
      # - `receiver`: Prism::node, its receiver.
      # - `operator_loc`: Prism::Location, where the operator is written.
      def self.new: (call: Prism::CallNode, receiver: Prism::node, operator_loc: Prism::Location) -> instance
                  | (Prism::CallNode call, Prism::node receiver, Prism::Location operator_loc) -> instance

      include OperatorSite

      # The class methods `of` and `edits`. `of` gives the prefix that a node
      # is, or nil when it isn't a call named one of the names and written as a
      # prefix operator. A call with a dot, such as `a.!` or `a&.!`, is one
      # written as a method call. A call built by hand without its receiver or
      # operator isn't one either. The names are those of the methods: `:-@`
      # for `-a`, `:+@` for `+a`, `:!` for `!a` and `not a`. In a table of
      # replacements, nil drops the operator, which makes the whole call the
      # receiver's source, and a string replaces the operator.
      extend OperatorSite::Reading[Prefix]

      # Whether the operator is `-` or `+` and its operand is a string
      # literal, as `Stryker::Mutators::Strings.literal?` defines it. Such a
      # sign doesn't negate: `-"draft"` returns the string frozen, and
      # `+"draft"` returns it unfrozen.
      def string_sign?: () -> bool

      # The prefix for `call`, or nil when `call` lacks its receiver or its
      # operator, as a call built by hand can.
      #
      # - `call`: Prism::CallNode, a call written as an operator.
      def self.written: (Prism::CallNode call) -> Prefix?
    end
  end
end
