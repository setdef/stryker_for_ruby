module Stryker
  module Mutators
    # What a walk does with the mutators of a run and the file it walks:
    # which of them are fallback mutators, which are excluded, and what the
    # file's disable comments say, and where it writes a warning about a site
    # that a mutator can't read or a name in a comment that no mutator has.
    # A mutator's mutant is still made when it
    # is excluded or a comment covers it, and it is `Ignored`, with
    # StrykerJS's text as its reason for an exclusion and the comment's
    # reason for a comment, as
    # [Turning mutators off](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/contributors/design/mutators.md#turning-mutators-off)
    # and
    # [The disable comment](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/contributors/design/mutators.md#the-disable-comment)
    # specify.
    #
    # ## Examples
    #
    # ```ruby
    # policy = Stryker::Mutators::Policy.new(excluded: ["StringLiteral"])
    # policy.reason(candidate)
    # # => "Ignored because of excluded mutation \"StringLiteral\""
    # ```
    class Policy
      # The reason text of an excluded mutator. Private.
      EXCLUDED: String

      # The directives of a file with no disable comment, which give no
      # reason for any candidate. Private.
      NO_DIRECTIVES: Directives

      @fallbacks: Array[_Mutator]
      @excluded: Array[String]
      @directives: Directives
      @warnings: _Warnings

      # Where the walk writes a warning.
      attr_reader warnings: _Warnings

      # Builds the policy.
      #
      # - `fallbacks`: Array of Stryker::_Mutator, the mutators whose mutants
      #   yield to every other live mutant. By default,
      #   `Stryker::Mutators::FALLBACKS`.
      # - `excluded`: Array of String, the names of the excluded mutators,
      #   matched exactly, with their letter case. Empty by default.
      # - `directives`: what the disable comments of the file say. By
      #   default, directives that say nothing.
      # - `warnings`: Stryker::_Warnings, where the walk writes a warning. By
      #   default, `$stderr`.
      def initialize: (?fallbacks: Array[_Mutator], ?excluded: Array[String], ?directives: Directives, ?warnings: _Warnings) -> void

      # The same policy, with the disable comments of one file.
      #
      # - `directives`: Stryker::Mutators::Directives, the file's comments.
      def reading: (Directives directives) -> Policy

      # Whether `candidate`'s mutator is a fallback mutator.
      #
      # - `candidate`: Stryker::Mutators::Candidate, the candidate.
      def fallback?: (Candidate candidate) -> bool

      # The reason `candidate`'s mutant is `Ignored`, or nil when the mutant
      # is live. A disable comment's reason wins over an exclusion's.
      #
      # - `candidate`: Stryker::Mutators::Candidate, the candidate.
      def reason: (Candidate candidate) -> String?

      private

      def excluded: (String name) -> String?
    end
  end
end
