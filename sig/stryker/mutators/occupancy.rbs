module Stryker
  module Mutators
    # Which nodes of a file hold live candidates, so that a walk can tell
    # whether a candidate is the only one on its site and inside it. An
    # ignored candidate holds no node, because its mutant never runs and
    # shows nothing. A node is inside
    # a site when the site's tree holds it, as a walk goes into it, so a
    # heredoc's body is inside the call that holds the heredoc, though the
    # body's bytes come after the call's.
    #
    # ## Examples
    #
    # ```ruby
    # occupancy = Stryker::Mutators::Occupancy.new(candidates)
    # occupancy.alone?(candidates.first)
    # # => true
    # ```
    class Occupancy
      # Counts the candidates on each node.
      #
      # - `candidates`: Array of Stryker::Mutators::Candidate, every candidate
      #   of the file, of every mutator in the walk. Only the live ones count.
      def initialize: (Array[Candidate] candidates) -> void

      # Whether `candidate` is the only live candidate on its site, and no
      # live candidate is on a node inside the site. An ignored `candidate`
      # holds its site no more than any other candidate does, so it is alone
      # when no live candidate is there.
      #
      # - `candidate`: Stryker::Mutators::Candidate, one of the candidates.
      def alone?: (Candidate candidate) -> bool

      private

      @counts: Hash[Prism::node, Integer]

      def held?: (Prism::node node) -> bool
    end
  end
end
