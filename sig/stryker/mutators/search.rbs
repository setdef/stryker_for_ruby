module Stryker
  module Mutators
    # Finds the candidates that one mutator makes in a parsed file. A file
    # that doesn't parse has no sites, so it raises ArgumentError. It tells
    # the person who runs Stryker (for Ruby) about each site the mutator can't
    # read. The warning goes to standard error, with the file and the line of
    # the site, and the site gets no candidate.
    #
    # ## Examples
    #
    # ```ruby
    # result = Prism.parse("x = 1 + 2")
    # search = Stryker::Mutators::Search.new(result, "lib/a.rb")
    # search.candidates_of(Stryker::Mutators::ArithmeticOperator).size
    # # => 1
    # ```
    class Search
      # Prepares to search the file.
      #
      # - `result`: Prism::ParseResult, the file parsed. A result with errors
      #   raises ArgumentError.
      # - `file`: String, the file's path, which a warning and the error give.
      def initialize: (Prism::ParseResult result, String file) -> void

      # The candidates of `mutator` in the file, in the order of the tree.
      #
      # - `mutator`: Stryker::_Mutator, the mutator to ask at every node.
      def candidates_of: (_Mutator mutator) -> Array[Candidate]

      private

      @tree: Prism::ProgramNode
      @file: String

      def candidates_at: (_Mutator mutator, Prism::node node, Array[Prism::node] ancestors) -> Array[Candidate]
    end
  end
end
