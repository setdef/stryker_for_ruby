module Stryker
  module Mutators
    # A number written with a sign, such as `-1`, `-2.5`, `+3r`, or `-2i`.
    # Prism makes it an `IntegerNode`, `FloatNode`, `RationalNode`, or
    # `ImaginaryNode`, and not a call to the unary minus or plus.
    #
    # ## Examples
    #
    # ```ruby
    # node = Prism.parse("-2.5").value.statements.body.first
    # Stryker::Mutators::SignedLiteral.of(node, nil).edit.replacement
    # # => "2.5"
    # ```
    class SignedLiteral < Data
      # The literal.
      attr_reader node: Prism::IntegerNode | Prism::FloatNode | Prism::RationalNode | Prism::ImaginaryNode

      # Builds the signed literal.
      #
      # - `node`: Prism::IntegerNode, Prism::FloatNode, Prism::RationalNode, or
      #   Prism::ImaginaryNode, the literal.
      def self.new: (node: Prism::IntegerNode | Prism::FloatNode | Prism::RationalNode | Prism::ImaginaryNode) -> instance
                  | (Prism::IntegerNode | Prism::FloatNode | Prism::RationalNode | Prism::ImaginaryNode node) -> instance

      # The signed literal that `node` is, or nil when it isn't a number
      # written with a minus or a plus sign, or when its value is zero. A zero
      # of the other sign is equal to it, except that a float's sign shows in
      # `1 / -0.0`, which only a test that divides by the value sees. The
      # number inside an imaginary literal such as `-2i` is none either: it
      # has the sign too, and the imaginary literal is the signed literal.
      #
      # - `node`: Prism::node, the node.
      # - `parent`: Prism::node, the node's parent, or nil at the root.
      def self.of: (Prism::node node, Prism::node? parent) -> SignedLiteral?

      # The edit that covers the whole literal and changes its sign: a minus
      # goes, so `-1_000` becomes `1_000`, and a plus becomes a minus, so
      # `+1_000` becomes `-1_000`.
      def edit: () -> Edit

      private def negative?: () -> bool

      private def unsigned: () -> String
    end
  end
end
