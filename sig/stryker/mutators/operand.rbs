module Stryker
  module Mutators
    # What a mutator that moves an operand to another place needs to know about
    # it: whether it holds a heredoc opener, which a move would part from its
    # body, and how to write it on the left of an operator.
    #
    # ## Examples
    #
    # ```ruby
    # call = Prism.parse("a <=> <<~TEXT\n  b\nTEXT\n").value.statements.body.first
    # Stryker::Mutators::Operand.holds_heredoc?(call.arguments.arguments.first)
    # # => true
    #
    # call = Prism.parse("a <=> defined? b").value.statements.body.first
    # Stryker::Mutators::Operand.left_text(call.arguments.arguments.first)
    # # => "(defined? b)"
    #
    # call = Prism.parse("a <=> x = 1").value.statements.body.first
    # Stryker::Mutators::Operand.left_text(call.arguments.arguments.first)
    # # => "(x = 1)"
    # ```
    module Operand
      # Whether `node`, or a node inside it, is a heredoc opener such as
      # `<<~TEXT`. The heredoc's body lies on the lines after the opener, outside
      # the operand, and the bodies follow their openers in order. A move that
      # takes one opener past another gives each the other's body.
      #
      # - `node`: Prism::node, the operand.
      def self.holds_heredoc?: (Prism::node node) -> bool

      # The text of `node` for the place left of a binary operator. An operand
      # that binds looser than an operator goes in parentheses: a `defined?`
      # with no parentheses, a `not` with none, an `and`, an `or`, or an
      # assignment such as `x = 1`, `b.c += 1`, or `b[0] ||= 1`. Without them,
      # `defined? b <=> a` reads as `defined?(b <=> a)`, and `x = 1 <=> a` as
      # `x = (1 <=> a)`. Any other operand is its source text, and so is one
      # already in parentheses.
      #
      # - `node`: Prism::node, the operand.
      def self.left_text: (Prism::node node) -> String

      private def self.heredoc_opener?: (Prism::node node) -> bool

      private def self.loose?: (Prism::node node) -> bool

      private def self.assignment?: (Prism::node node) -> bool
    end
  end
end
