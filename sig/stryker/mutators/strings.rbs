module Stryker
  module Mutators
    # Tells a string literal from other nodes, for the mutators that skip an
    # operand that is one.
    #
    # ## Examples
    #
    # ```ruby
    # node = Prism.parse("'=' * 40").value.statements.body.first.receiver
    # Stryker::Mutators::Strings.literal?(node)
    # # => true
    # ```
    module Strings
      # Whether `node` is a string literal: a `StringNode`, which a heredoc
      # also makes, an `InterpolatedStringNode`, an `XStringNode`, a backtick
      # or `%x` command with no interpolation, or an `InterpolatedXStringNode`,
      # one with interpolation. A string inside parentheses is a
      # `ParenthesesNode`, so it isn't one.
      #
      # - `node`: Prism::node, the node.
      def self.literal?: (Prism::node node) -> bool

      LITERALS: Array[singleton(Prism::Node)]
    end
  end
end
