module Stryker
  module Mutators
    # A call written as an operator between a receiver and one argument, such
    # as `a + b`, and not as a method call, such as `a.+(b)`. A mutator that
    # changes the operator takes its edits from here.
    #
    # ## Examples
    #
    # The edits that a table of pairs makes of `a + b`, with no operation
    # skipped:
    #
    # ```ruby
    # call = Prism.parse("a + b").value.statements.body.first
    # Stryker::Mutators::Operation.edits(call, { "+": %w[-] }) { false }
    # # => [#<data Stryker::Edit start_offset=0, end_offset=5, replacement="a - b">]
    # ```
    class Operation < Data
      # The call.
      attr_reader call: Prism::CallNode

      # The call's receiver: the left operand.
      attr_reader receiver: Prism::node

      # The call's one argument: the right operand.
      attr_reader argument: Prism::node

      # Where the operator is written.
      attr_reader operator_loc: Prism::Location

      # Builds the operation.
      #
      # - `call`: Prism::CallNode, the call.
      # - `receiver`: Prism::node, its receiver.
      # - `argument`: Prism::node, its argument.
      # - `operator_loc`: Prism::Location, where the operator is written.
      def self.new: (call: Prism::CallNode, receiver: Prism::node, argument: Prism::node, operator_loc: Prism::Location) -> instance
                  | (Prism::CallNode call, Prism::node receiver, Prism::node argument, Prism::Location operator_loc) -> instance

      include OperatorSite

      # The class methods `of` and `edits`. `of` gives the operation that a
      # node is, or nil when it isn't a call named one of the names and
      # written as an operator between a receiver and one argument. A call with
      # a dot, such as `a.+(b)` or `a&.+(b)`, is one written as a method call,
      # and a prefix operator, such as `-a`, is a call named `-@`. A call built
      # by hand without its receiver, argument, or operator isn't one either.
      extend OperatorSite::Reading[Operation]

      # Whether either operand is a string literal, as
      # `Stryker::Mutators::Strings.literal?` defines it. Such an operator
      # repeats, formats, or joins, as in `"=" * 40`.
      def string_operand?: () -> bool

      # The operation for `call`, or nil when `call` lacks its receiver, its
      # argument, or its operator, as a call built by hand can.
      #
      # - `call`: Prism::CallNode, a call written as an operator.
      def self.written: (Prism::CallNode call) -> Operation?
    end
  end
end
