module Stryker
  module Mutators
    # Swaps a logical operator for the other one. It mutates an `AndNode` or an
    # `OrNode`, and makes one mutant of each:
    #
    # | Original | Mutant |
    # | - | - |
    # | `a && b` | `a \|\| b` |
    # | `a \|\| b` | `a && b` |
    # | `a and b` | `a or b` |
    # | `a or b` | `a and b` |
    #
    # The edit covers the whole node, and the text between the operands stays
    # as it was. A chain of `||` needs one more step: `a || b || c` becomes
    # `(a || b) && c`, which keeps the grouping of the original.
    #
    # It makes no mutant of an operator that has the check that a file is the
    # script, `__FILE__ == $0`, as an operand, as in `__FILE__ == $0 and main`:
    # the mutant would run the script's code inside the test process.
    # [Mutators](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/contributors/design/mutators.md#logicaloperator)
    # specifies the pairs.
    #
    # ## Examples
    #
    # ```ruby
    # node = Prism.parse("ok = a && b").value.statements.body.first.value
    # Stryker::Mutators::LogicalOperator.edits(node, []).map(&:replacement)
    # # => ["a || b"]
    # ```
    module LogicalOperator
      # The mutator's name in the report: `"LogicalOperator"`.
      def self.name: () -> String

      # The edit at `node`: one for an `AndNode` or an `OrNode`, none for any
      # other node.
      #
      # - `node`: Prism::node, a node of the file.
      # - `_ancestors`: Array of Prism::node, the nodes above it, which this
      #   mutator doesn't read.
      def self.edits: (Prism::node node, Array[Prism::node] _ancestors) -> Array[Edit]

      SWAPS: Hash[Symbol, String]
    end
  end
end
