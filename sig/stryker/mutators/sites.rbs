module Stryker
  module Mutators
    # Leaves out of a walk the sites that no mutator makes a mutant of, from
    # the table of
    # [Sites that get no mutant](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/contributors/design/mutators.md#sites-that-get-no-mutant)
    # that belong to the tree and not to one mutator:
    #
    # - the arguments of a call to `require`, `require_relative`, `load`, or
    #   `autoload` with no receiver, and of `autoload` on a module, because
    #   Ruby evaluates them while the file loads;
    # - a call with no receiver to `sig` with a block, which is a Sorbet type
    #   signature, and everything inside it.
    #
    # ## Examples
    #
    # ```ruby
    # call = Prism.parse("require 'json'").value.statements.body.first
    # Stryker::Mutators::Sites.children(call)
    # # => []
    # ```
    module Sites
      # The children of `node` that a walk goes into, in the order of
      # `node.compact_child_nodes`. The children that the rules above leave
      # out aren't in it, and a node that is a type signature has none.
      #
      # - `node`: Prism::node, a node of the file.
      def self.children: (Prism::node node) -> Array[Prism::node]

      # Whether `node` is a call with no receiver to `sig` with a block, a
      # Sorbet type signature.
      #
      # - `node`: Prism::node, a node of the file.
      def self.type_signature?: (Prism::node node) -> bool

      # Whether `call` loads a file: a call to `require`,
      # `require_relative`, `load`, or `autoload` with no receiver, or to
      # `autoload` on a module.
      #
      # - `call`: Prism::CallNode, the call.
      def self.loader?: (Prism::CallNode call) -> bool

      LOADERS: Array[Symbol]

      private def self.loader_arguments: (Prism::node node) -> Prism::ArgumentsNode?
    end
  end
end
