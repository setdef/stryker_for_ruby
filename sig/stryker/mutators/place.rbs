module Stryker
  module Mutators
    # Where a node stands in the code around it: the node that holds it, the
    # node that holds that one, and the node in the place. Parentheses around
    # one statement are no place of their own, so the statement stands where
    # the parentheses stand.
    #
    # ## Examples
    #
    # ```ruby
    # tree = Prism.parse("run if (ready)").value
    # node = tree.statements.body.first
    # parentheses = node.predicate
    # statement = parentheses.body.body.first
    # ancestors = [tree, tree.statements, node, parentheses, parentheses.body]
    # Stryker::Mutators::Place.of(statement, ancestors).parent.class
    # # => Prism::IfNode
    # ```
    class Place < Data
      # The node that holds the place, or nil for the root of the file.
      attr_reader parent: Prism::node?

      # The node in the place: the node itself, or the outermost parentheses
      # around it.
      attr_reader child: Prism::node

      # The node that holds the parent, such as the `def` whose body the
      # parent is, or nil when the parent is the root of the file or there is
      # no parent.
      attr_reader grandparent: Prism::node?

      # Builds the place.
      #
      # - `parent`: Prism::node, or nil at the root, the node that holds it.
      # - `child`: Prism::node, the node in the place.
      # - `grandparent`: Prism::node, or nil, the node that holds the parent.
      def self.new: (parent: Prism::node?, child: Prism::node, grandparent: Prism::node?) -> instance
                  | (Prism::node? parent, Prism::node child, Prism::node? grandparent) -> instance

      # Where `node` stands.
      #
      # - `node`: Prism::node, the node.
      # - `ancestors`: Array of Prism::node, the nodes above `node`, from the
      #   root of the file to its parent.
      def self.of: (Prism::node node, Array[Prism::node] ancestors) -> Place

      private def self.unwrapped: (Prism::node child, Array[Prism::node] chain) -> [Prism::node, Array[Prism::node]]

      private def self.one_statement?: (Prism::node? statements) -> bool
    end
  end
end
