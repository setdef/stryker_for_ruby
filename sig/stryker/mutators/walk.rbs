module Stryker
  module Mutators
    # Walks a parsed file, asks each mutator for its edits at every node, and
    # returns the file's mutants with their IDs. Each mutator gets a walk of
    # its own through the file.
    #
    # The mutants come in the order of the catalog's table: each mutator's
    # mutants in turn, in the order of the list given, and each mutator's own
    # in the order its sites start in the file. The edits of one site stay in
    # the order the mutator gave them. A mutator that the policy excludes
    # still makes its mutants, and each of them is `Ignored`, with
    # `Stryker::Mutators::Policy`'s reason, and has an ID like any other. A
    # fallback mutator's mutant is made only where no other live mutant is,
    # on its site or inside it, so an ignored mutant holds no removal back.
    # `Stryker::Mutators::Roster` leaves out the mutants that would show
    # nothing and numbers the rest, and `Stryker::Mutators::Traversal` leaves
    # out the sites that no mutator makes a mutant of. A mutator that can't
    # read a site raises `Stryker::Mutators::Unreadable`, and
    # `Stryker::Mutators::Search` writes a warning with the file and the line
    # to standard error, makes no mutant of the site, and goes on.
    #
    # ## Examples
    #
    # Every mutant of a file, with the IDs of the second file of a run
    # following those of the first:
    #
    # ```ruby
    # result = Prism.parse("total = a + b\n")
    # walk = Stryker::Mutators::Walk.new(file: "lib/invoice.rb", result:, first_id: 8)
    # walk.mutants.map { |mutant| [mutant.id, mutant.mutator_name, mutant.replacement] }
    # # => [[8, "ArithmeticOperator", "a - b"]]
    # ```
    #
    # The same file with `ArithmeticOperator` excluded:
    #
    # ```ruby
    # policy = Stryker::Mutators::Policy.new(excluded: ["ArithmeticOperator"])
    # walk = Stryker::Mutators::Walk.new(file: "lib/invoice.rb", result:, policy:)
    # walk.mutants
    # # => []
    # walk.ignored.map(&:status_reason)
    # # => ["Ignored because of excluded mutation \"ArithmeticOperator\""]
    # ```
    class Walk
      # Prepares to walk the file.
      #
      # - `file`: String, the file's path, which each mutant holds.
      # - `result`: Prism::ParseResult, the file parsed. A result with errors
      #   raises ArgumentError.
      # - `mutators`: Array of Stryker::_Mutator, the mutators to ask, in the
      #   order of the catalog's table. By default, `Stryker::Mutators::ALL`.
      # - `first_id`: Integer, the ID of the first mutant.
      # - `policy`: Stryker::Mutators::Policy, which mutators are fallbacks
      #   and which are excluded. By default, the fallbacks of
      #   `Stryker::Mutators::FALLBACKS` and no exclusions.
      def initialize: (file: String, result: Prism::ParseResult, ?mutators: Array[_Mutator], ?first_id: Integer, ?policy: Policy) -> void

      # The file's live mutants, in the order above, which get a switch.
      def mutants: () -> Array[Mutant]

      # The results of the file's ignored mutants, in the order above. Each
      # has the status `Ignored` and its reason.
      def ignored: () -> Array[MutantResult]

      # The file's live mutants and the results of its ignored mutants
      # together.
      def made: () -> Made

      private

      @search: Search
      @mutators: Array[_Mutator]
      @policy: Policy
      @roster: Roster
      @made: Made

      def found_by: (_Mutator mutator) -> Array[Candidate]

      def judged: (Array[Candidate] candidates) -> Array[Candidate]

      def chosen: (Array[Candidate] candidates) -> Array[Candidate]
    end
  end
end
