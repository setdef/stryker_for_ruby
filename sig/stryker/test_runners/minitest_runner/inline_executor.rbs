module Stryker
  module TestRunners
    class MinitestRunner
      # A `Minitest.parallel_executor` that runs each test it is given at
      # once, in the thread that gives it. A class that calls
      # `parallelize_me!` hands its tests to the parallel executor, so while
      # `around` runs a block, such a test runs in its turn, in the thread
      # that runs the class.
      #
      # ## Examples
      #
      # ```ruby
      # Stryker::TestRunners::MinitestRunner::InlineExecutor.around do
      #   Shop::DiscountTest.run_suite(reporter, include: /\Atest_rate\z/)
      # end
      # ```
      module InlineExecutor
        # Makes itself `Minitest.parallel_executor` while the block runs, and
        # puts back the one before it afterwards, even when the block raises.
        # Returns what the block returns.
        def self.around: [T] () { () -> T } -> T

        # Runs the job's test at once, and records its result in the job's
        # reporter.
        #
        # - `job`: Array, the test's class, its method's name, and the
        #   reporter, as a `parallelize_me!` class hands them over.
        def self.<<: ([singleton(::Minitest::Runnable), String, Outcome] job) -> void
      end
    end
  end
end
