module Stryker
  class Pipeline
    # What a trial came to, and how the run ends with it: a trial that went on
    # from its dry run to its mutants tested them, whether it had a mutant or
    # not, and a trial that stopped at a dry run that found no test, which
    # `allow_empty` allowed, tested none. An outcome tells its listener which
    # of the two it is, and the listener decides what to do about it.
    #
    # ## Examples
    #
    # ```ruby
    # Stryker::Pipeline::Outcome.tested([]).tell(pipeline)
    # # calls pipeline.completed([])
    # Stryker::Pipeline::Outcome.untested.tell(pipeline)
    # # calls pipeline.nothing_tested
    # ```
    module Outcome
      # What an outcome tells what happened to.
      interface _Listener
        # A trial tested its mutants, with no mutant or with some.
        def completed: (Array[MutantResult] results) -> void

        # A trial stopped at its dry run, which found no test.
        def nothing_tested: () -> void
      end

      # Either outcome.
      interface _Told
        # Tells the listener what happened, and returns the results that the
        # run came to.
        #
        # - `listener`: responds to `completed` and `nothing_tested`.
        def tell: (_Listener listener) -> Array[MutantResult]
      end

      # The outcome of a trial that went on from its dry run to its mutants.
      class Tested
        @results: Array[MutantResult]

        # Builds the outcome.
        #
        # - `results`: Array of Stryker::MutantResult, the result of every
        #   mutant, in the order of the mutants' IDs. Empty when the run has no
        #   mutant.
        def initialize: (Array[MutantResult] results) -> void

        # Calls `completed` on the listener with the results, and returns
        # them.
        #
        # - `listener`: responds to `completed` and `nothing_tested`.
        def tell: (_Listener listener) -> Array[MutantResult]
      end

      # The outcome of a trial that stopped at its dry run, which found no
      # test and was allowed to.
      class Untested
        @results: Array[MutantResult]

        # Builds the outcome, which has no result.
        def initialize: () -> void

        # Calls `nothing_tested` on the listener, and returns no result, as
        # StrykerJS returns none.
        #
        # - `listener`: responds to `completed` and `nothing_tested`.
        def tell: (_Listener listener) -> Array[MutantResult]
      end

      # The outcome of a trial that went on from its dry run to its mutants.
      #
      # - `results`: Array of Stryker::MutantResult, the result of every
      #   mutant, in the order of the mutants' IDs.
      def self.tested: (Array[MutantResult] results) -> Tested

      # The outcome of a trial that stopped at its dry run.
      def self.untested: () -> Untested
    end
  end
end
