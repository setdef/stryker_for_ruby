module Stryker
  # Raised when the project's code does something that **Stryker (for Ruby)**
  # can't record truthfully, so that a run fails instead of reporting a
  # result that rests on lost data. The message says what happened.
  #
  # A switch that runs in a Ractor that started before the runtime loaded
  # raises it, because no collector records that Ractor's hits. The test
  # that ran the switch fails, so the dry run fails and no mutant runs.
  class UnsupportedError < StandardError
  end
end
