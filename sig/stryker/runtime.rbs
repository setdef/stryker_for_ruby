module Stryker
  # The holder of the active mutant's ID, which every switch in instrumented
  # source reads. A switch calls `::Stryker::Active.id` to choose its branch,
  # and `::Stryker::Active.hit` with the IDs of its mutants each time its
  # original branch runs.
  #
  # `require "stryker/runtime"` sets it. In a run of the project's code with
  # no mutant active, it is a Stryker::Runtime::Recording, which records hits.
  # With a mutant active, it is a Stryker::Runtime::ActiveMutant, which records
  # none. It is frozen and shareable, so a Ractor other than the main one can
  # read it.
  Active: Runtime::_Holder

  # The part of **Stryker (for Ruby)** that loads in a process that runs the
  # project's code: the holder of the active mutant's ID, and the hit
  # recorder, as
  # [Loading and isolation](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/contributors/design/loading-and-isolation.md#the-active-mutants-holder)
  # and [Coverage](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/contributors/design/coverage.md)
  # specify. It loads nothing outside the standard library.
  #
  # `require "stryker/runtime"` starts the runtime from the environment
  # with `Stryker::Runtime.start`, before any of the project's code loads.
  # When `STRYKER_ACTIVE_MUTANT` holds a mutant's ID, as it does in the
  # fresh process of a static mutant's run, that mutant is active from the
  # start, so its switch takes the mutated branch while its file loads.
  # Otherwise no mutant is active, and every hit goes to
  # `Stryker::Runtime::RECORDER`. On a Ruby older than 4.0, which the
  # project doesn't support, loading it also writes one line about that to
  # standard error, with Stryker::Runtime::OlderRuby.
  #
  # With no mutant active, the runtime also prepends
  # Stryker::Runtime::FirstRactor to `Ractor`'s singleton class, so the
  # process's collector Ractor starts at the project's first `Ractor.new`,
  # and a hit from another Ractor reaches the recorder in every process that
  # records hits, as
  # [Ractors](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/contributors/design/coverage.md#ractors)
  # specifies. A project that makes no Ractor gets none from the runtime.
  # A process that forks calls `Stryker::Runtime::RECORDER.drain` before
  # each fork, so the hits that Ractors made while it loaded are in the
  # static bucket that its children inherit. A forked child can't use the
  # collector that its parent started: the dry run's child calls
  # `Stryker::Runtime.start_dry_run`, whose collector starts at the child's
  # first `Ractor.new`, and a mutant run's child calls
  # `Stryker::Runtime.activate_mutant`.
  #
  # ## Examples
  #
  # A fresh process for a static run of mutant 7:
  #
  # ```console
  # $ STRYKER_ACTIVE_MUTANT=7 ruby -Ilib -rstryker/runtime -e 'p Stryker::Active.id'
  # 7
  # ```
  #
  # A forked child that runs mutant 7, after its parent loaded the project's
  # code with no mutant active:
  #
  # ```ruby
  # Stryker::Active.id
  # # => nil
  # Stryker::Runtime.activate_mutant(7)
  # Stryker::Active.id
  # # => 7
  # ```
  module Runtime
    # What reaches the recorder from a holder: the IDs of the mutants at one
    # switch, for a hit, or the path of a file whose load began.
    type message = Array[Integer] | String

    # What `Stryker::Active` holds: the active mutant's ID, the method that
    # every switch calls to record a hit, and the method that the loader's
    # hook calls when a file begins to load.
    interface _Holder
      # The active mutant's ID, or nil when no mutant is active.
      def id: () -> Integer?

      # Records that the code at the sites of the mutants with `ids` ran,
      # or does nothing in a mutant run. Returns nil.
      #
      # - `ids`: Integer, each mutant's ID.
      def hit: (*Integer ids) -> nil

      # Records that the file at `path` began to load, or does nothing in a
      # mutant run. Returns nil. The loader's hook calls it for every file
      # that Ruby compiles from disk, before the file's code runs, with the
      # path that Ruby gave the hook.
      #
      # - `path`: String, the file's path.
      def load_began: (String path) -> nil
    end

    # Where `Stryker::Runtime.start` reads the active mutant's ID. `ENV` is
    # one, and so is a Hash of Strings.
    interface _Environment
      # The value of the variable `name`, or `default` when it isn't set.
      def fetch: (String name, nil default) -> String?
    end

    # The name of the environment variable that holds the active mutant's
    # ID, `"STRYKER_ACTIVE_MUTANT"`.
    VARIABLE: String

    # The collector that this process records hits with.
    PROCESS_COLLECTOR: ProcessCollector

    # The hit recorder of this process. Every hit made with no mutant active
    # goes here. It drains `PROCESS_COLLECTOR`.
    RECORDER: Recorder

    # Starts the runtime from `environment`, as `require "stryker/runtime"`
    # does with `ENV`. When its `STRYKER_ACTIVE_MUTANT` holds a mutant's ID,
    # that mutant becomes active, as `Stryker::Runtime.activate_mutant` does
    # it. Otherwise no mutant is active, and the process records hits, as
    # `Stryker::Runtime.start_dry_run` does it, with the collector that
    # `Stryker::Runtime::FirstRactor.prepare` builds. Raises ArgumentError
    # when the variable holds anything other than a decimal integer, an
    # empty string included.
    #
    # - `environment`: Stryker::Runtime::_Environment, such as `ENV`.
    # - `namespace`: Module, where the constant is. Stryker by default.
    # - `process_collector`: Stryker::Runtime::ProcessCollector.
    #   `Stryker::Runtime::PROCESS_COLLECTOR` by default.
    #
    # ```ruby
    # Stryker::Runtime.start({ "STRYKER_ACTIVE_MUTANT" => "7" })
    # Stryker::Active
    # # => #<data Stryker::Runtime::ActiveMutant id=7>
    # ```
    def self.start: (?_Environment environment, ?Module namespace, ?ProcessCollector process_collector) -> _Holder

    # Makes `holder` shareable and sets `namespace`'s `Active` constant to
    # it, replacing the holder there. It removes the old constant first, so
    # Ruby gives no warning. Code compiled before the replacement, a
    # forked child's included, reads the new holder, in every Ractor.
    #
    # Call it before a run's tests start: a switch that runs on another
    # thread while the constant is replaced can raise NameError. A static
    # mutant's switch has already run by then, so only a fresh process with
    # `STRYKER_ACTIVE_MUTANT` set before load makes a static mutant active.
    #
    # - `holder`: Stryker::Runtime::_Holder, the new holder.
    # - `namespace`: Module, where the constant is. Stryker by default.
    def self.activate: (_Holder holder, ?Module namespace) -> _Holder

    # Makes the mutant with `id` active, as `Stryker::Runtime.activate`
    # does with a Stryker::Runtime::ActiveMutant. A forked child or a pool
    # process calls it before its run. It also makes `process_collector`
    # hold no collector from then on, because a forked child can't use the
    # collector that its parent started, and a mutant run records no hit.
    #
    # - `id`: Integer, the mutant's ID.
    # - `namespace`: Module, where the constant is. Stryker by default.
    # - `process_collector`: Stryker::Runtime::ProcessCollector.
    #   `Stryker::Runtime::PROCESS_COLLECTOR` by default.
    def self.activate_mutant: (Integer id, ?Module namespace, ?ProcessCollector process_collector) -> _Holder

    # Readies the process to record hits: it hands `collector` to
    # `process_collector`, which the recorder drains when each test starts
    # and ends, and makes
    # `namespace`'s `Active` a Stryker::Runtime::Recording that sends to
    # `collector` each hit made in a Ractor other than the main one.
    # `Stryker::Runtime.start` calls it when no mutant is active. The dry
    # run's forked child calls it again before its first test, after the
    # fork: in a forked child, a send to a Ractor that the parent started
    # raises Ractor::ClosedError. A second call in one process raises
    # RuntimeError, because the hits sent to the first collector would be
    # lost: the isolation adapter that calls it twice has a fault.
    #
    # The default collector is a new one, whose Ractor starts at the
    # process's first `Ractor.new`. In a forked child, that is the child's
    # first, and Ruby warns that Ractors are experimental for it as it would
    # without the runtime.
    #
    # Call it with no arguments. The arguments are internal to the runtime,
    # and exist so that a test can pass stand-ins:
    #
    # - `collector`: Stryker::Runtime::Collector. A new collector by default.
    # - `namespace`: Module, where the constant is. Stryker by default.
    # - `process_collector`: Stryker::Runtime::ProcessCollector, which holds
    #   the collector. `Stryker::Runtime::PROCESS_COLLECTOR` by default.
    #
    # ```ruby
    # Stryker::Runtime.start_dry_run
    # Stryker::Runtime::RECORDER.test_started(test)
    # Ractor.new { Stryker::Active.hit(7) }.join
    # Stryker::Runtime::RECORDER.test_finished(result)
    # Stryker::Runtime::RECORDER.tests[test]
    # # => #<Set: {7}>
    # ```
    def self.start_dry_run: (?Collector collector, ?Module namespace, ?ProcessCollector process_collector) -> _Holder
  end
end
