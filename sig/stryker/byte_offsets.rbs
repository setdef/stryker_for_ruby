module Stryker
  # Checks that byte offsets into a text are ones the text can have: from 0
  # up to the size of the text in bytes, on a character boundary, with a
  # start no later than its end. SourceText uses it before it turns offsets
  # into positions.
  module ByteOffsets
    # Raises ArgumentError unless the stretch of `text` from byte offset
    # `start_offset` up to byte offset `end_offset` is a stretch of whole
    # characters. The message names the offset at fault, or both offsets when
    # the start is after the end, and the size of the text in bytes.
    #
    # - `text`: String, the text the offsets index into.
    # - `start_offset`: Integer, the offset in bytes of the start of the
    #   stretch.
    # - `end_offset`: Integer, the offset in bytes of the end of the stretch.
    #
    # ```ruby
    # Stryker::ByteOffsets.check("a = \"\u{20AC}\"", 6, 7)
    # # raises ArgumentError: byte offset 6 is not on a character boundary,
    # #   in a text of 8 bytes
    # ```
    def self.check: (String text, Integer start_offset, Integer end_offset) -> void

    # A truthy value when `offset` is a byte offset on a character boundary
    # of `text`, from 0 up to the size of `text` in bytes, and `false` or
    # `nil` when it is not. Ruby's String#byteindex does the check for a
    # character boundary.
    #
    # - `text`: String, the text the offset indexes into.
    # - `offset`: Integer, the offset in bytes.
    def self.boundary?: (String text, Integer offset) -> (Integer | false | nil)

    # Raises ArgumentError with `message`, followed by the size of `text` in
    # bytes.
    private def self.refuse: (String text, String message) -> bot
  end
end
