module Stryker
  module Reporters
    class MutationReport
      # One mutant of the report, as a reporter reads it: its file, status, mutator,
      # location, and the lines it changes. `to_h` gives the schema's
      # `MutantResult` of it.
      class MutantEntry
        @result: MutantResult

        @file: ProjectFile

        # The statuses of a mutant that no test caught. Private.
        UNDETECTED: Array[String]

        # Builds the entry.
        #
        # - `result`: Stryker::MutantResult, the mutant's result.
        # - `file`: Stryker::Reporters::ProjectFile, the file the mutant changes.
        def initialize: (MutantResult result, ProjectFile file) -> void

        # The path of the file the mutant changes, to put in a line of text:
        # each byte that isn't valid UTF-8 is spelled as `\xE9`.
        def display_path: () -> String

        # The result's status.
        def status: () -> String

        # Whether the status is `Survived`.
        def survived?: () -> bool

        # Whether no test caught the mutant: its status is `Survived` or
        # `NoCoverage`.
        def undetected?: () -> bool

        # The name of the mutator that made the mutant.
        def mutator_name: () -> String

        # The range the mutant replaces, with columns in UTF-16 code units.
        def location: () -> Location

        # The lines the mutant changes, as they are and as they become.
        def excerpt: () -> MutantExcerpt

        # The IDs of the tests that reached the mutant.
        def covered_by: () -> Array[String]

        # The IDs of the tests that killed the mutant.
        def killed_by: () -> Array[String]

        # Whether the mutant was static.
        def static?: () -> bool

        # How many tests finished in the mutant's run, or 0 when it didn't run.
        def tests_completed: () -> Integer

        # The entry as a Hash with the schema's keys as Symbols.
        def to_h: () -> Hash[Symbol, report_value]

        private

        # The result's mutant.
        def mutant: () -> Mutant
      end
    end
  end
end
