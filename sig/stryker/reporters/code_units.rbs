module Stryker
  module Reporters
    # Cuts a String at a count of UTF-16 code units, as JavaScript cuts a string,
    # because the report counts columns in them. A character outside the Basic
    # Multilingual Plane, such as an emoji, takes two.
    #
    # ## Examples
    #
    # ```ruby
    # Stryker::Reporters::CodeUnits.head("a\u{1F600}b", 3)
    # # => "a\u{1F600}"
    # Stryker::Reporters::CodeUnits.tail("a\u{1F600}b", 3)
    # # => "b"
    # ```
    module CodeUnits
      # The first `count` code units of `text`.
      #
      # - `text`: String, the text to cut.
      # - `count`: Integer, how many code units to keep.
      def self.head: (String text, Integer count) -> String

      # The code units of `text` after the first `count`.
      #
      # - `text`: String, the text to cut.
      # - `count`: Integer, how many code units to leave out.
      def self.tail: (String text, Integer count) -> String

      # Turns UTF-16 bytes into a UTF-8 String. Private.
      def self.decoded: (String? bytes) -> String
    end
  end
end
