module Stryker
  class CLI
    # Decides what a run does with the ERB templates that the `mutate`
    # patterns select. **Stryker (for Ruby)** mutates Ruby files only, so a
    # template that a pattern of the user's selects stops the run, as
    # Stryker::Instrumentation says. A template that only the default
    # patterns select isn't the user's choice, so the run leaves it out, and
    # says so once.
    class Templates
      # The extension of a template. Private.
      TEMPLATE: String

      # The pattern that leaves every template out. Private.
      LEAVE_OUT: String

      @config: Config

      @root: String

      # Builds the decision.
      #
      # - `config`: Stryker::Config, whose `mutate` holds the patterns.
      # - `root`: String, the project's root.
      def initialize: (Config config, String root) -> void

      # Returns the config for the run. When the user gave `mutate`, it is
      # the same config, with every template that a pattern selects still
      # selected. When the default selects at least one template, it is a
      # config whose patterns end with `!**/*.erb`, and one warning on
      # `stderr` (Stryker::CLI::LeftOutTemplates) says how many it left out.
      # When the default selects none, it is the same config, and nothing is
      # written.
      #
      # - `stderr`: where the warning goes.
      def config: (IO | StringIO stderr) -> Config

      private

      # How many templates the patterns select, with the files they select
      # found in the project's root.
      def templates: () -> Integer

      # The patterns of the config.
      def patterns: () -> Array[String]
    end
  end
end
