module Stryker
  class CLI
    # The pipeline that the command uses until the stages that run mutation
    # testing exist. It does no run and says so.
    class UnbuiltPipeline
      # The message of the error that `call` raises.
      MESSAGE: String

      # Raises Stryker::UnsupportedError with `MESSAGE`, so the command exits
      # with status 2.
      def call: (Config config, **Object streams) -> Numeric?
    end
  end
end
