module Stryker
  class CLI
    # The two streams that the command writes to, each wrapped in a
    # Stryker::CLI::Output: standard output for the primary output, and
    # standard error for errors and progress.
    class Streams < Data
      # Where the primary output goes.
      attr_reader stdout: Output

      # Where errors and progress go.
      attr_reader stderr: Output

      # Builds the streams from standard output and standard error, in that order.
      def self.new: (Output stdout, Output stderr) -> instance

      # Flushes standard output and then standard error. Raises
      # Stryker::CLI::OutputClosed when the reader of either has gone.
      def flush: () -> void
    end
  end
end
