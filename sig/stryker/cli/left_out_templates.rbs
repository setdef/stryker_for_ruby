module Stryker
  class CLI
    # The warning that `stryker run` writes to standard error when the
    # default `mutate` patterns select ERB templates: it says how many the
    # run leaves out, why, and how to choose files of your own. A pattern
    # that the user wrote and that selects a template is an error instead,
    # which Stryker::Instrumentation words.
    class LeftOutTemplates
      @count: Integer

      # Builds the warning.
      #
      # - `count`: Integer, how many templates the run leaves out. It is 1
      #   or more.
      def initialize: (Integer count) -> void

      # The one-line warning, with the count and "template" or "templates"
      # to match it.
      def to_s: () -> String
    end
  end
end
