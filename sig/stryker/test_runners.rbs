module Stryker
  # The adapters of the `Stryker::_TestRunner` port, one for each test
  # framework. Each loads in a project process, so it uses nothing outside
  # the standard library and the framework, which the project already has.
  # [Test runners](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/contributors/design/test-runners.md)
  # specifies them.
  module TestRunners
  end
end
