module Stryker
  # The contract tests: one Minitest module for each port, holding the tests
  # that every adapter of that port passes. `require "stryker/testing"` loads
  # them, in a test process that already uses Minitest.
  # [Contract tests](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/design/architecture.md#contract-tests)
  # says how they fit.
  #
  # - `Stryker::Testing::TestRunnerContract` checks an adapter of the
  #   `Stryker::_TestRunner` port.
  # - `Stryker::Testing::ConfigSourceContract` checks an adapter of the
  #   `Stryker::_ConfigSource` port.
  # - `Stryker::Testing::IsolationContract` checks an adapter of the
  #   `Stryker::_Isolation` port.
  module Testing
    # What a test class that includes `Stryker::Testing::ConfigSourceContract`
    # defines.
    interface _ConfigSourceHost
      # The adapter under test, built to read the file at `path`.
      def source_under_test: (String path) -> _ConfigSource

      # The text, in the adapter's format, of a file that holds `options`.
      def format_text: (Hash[String, JsonValue::json_value] options) -> String

      # Text that is not valid in the adapter's format.
      def malformed_text: () -> String

      # Text that is valid in the adapter's format but holds a list or a
      # single value, not an object.
      def non_object_text: () -> String
    end

    # What a test class that includes `Stryker::Testing::IsolationContract`
    # defines.
    interface _IsolationHost
      # A new adapter under test, not yet started, for the sample project in
      # `root`, whose instrumented source is in the cache at `directory`.
      # The contract starts and stops it.
      #
      # - `directory`: String, the cache's directory.
      # - `root`: String, the sample project's root.
      def isolation_under_test: (String directory, String root) -> _Isolation

      # Whether the adapter runs static mutants, so that the contract gives
      # it static runs. Otherwise it gives it runtime runs.
      def runs_static_mutants?: () -> bool
    end

    # What a test class that includes `Stryker::Testing::TestRunnerContract`
    # defines.
    interface _TestRunnerHost
      # The adapter under test, for a project whose suite is the contract's
      # sample suite. The contract calls `load_tests` on it before each
      # `run`, so it may return the same adapter every time.
      def runner_under_test: () -> _TestRunner

      # The ID of each test of the sample suite, keyed by its role in
      # `Stryker::Testing::TestRunnerContract::ROLES`.
      def sample_test_ids: () -> Hash[Symbol, String]
    end
  end
end
