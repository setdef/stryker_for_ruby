module Stryker
  module Isolation
    # One run in a fresh process, as the orchestrator keeps it: the run, and
    # a temporary folder of the run's own, made with `Dir.mktmpdir`, which holds the file that
    # holds the process's run, the file the process writes its messages to,
    # and the files of its standard output and standard error. No name that
    # the project chose becomes part of a path. When it is told to land, it
    # hands the process's messages and how the process ended to the block it
    # was built with, which judges the run, as a `Stryker::Isolation::Flight`
    # does for a forked child.
    #
    # ## Examples
    #
    # ```ruby
    # fresh = Stryker::Isolation::FreshRun.judged(run) { |result| puts(result.status) }
    # fresh.paths
    # # => ["<folder>/run", "<folder>/results"]
    # fresh.land(ending)
    # # prints Killed
    # ```
    class FreshRun
      # The run.
      attr_reader run: MutantRun

      # What judges the run from its process's messages and ending.
      @landing: ^(Messages messages, Ending ending) -> void

      # The run's folder.
      @folder: String

      # The files of the process's standard output and standard error.
      @outputs: OutputFiles

      # The fresh run of the mutant run `run`, which yields the run's result, as `Stryker::Isolation::Verdict` gives it,
      # when it lands.
      #
      # - `run`: Stryker::MutantRun, the run.
      def self.judged: (MutantRun run) { (MutantResult result) -> void } -> FreshRun

      # Makes the run's folder.
      #
      # - `run`: Stryker::MutantRun, the run.
      # - the block: what judges the run, given the process's messages and
      #   how the process ended, when the run lands.
      def initialize: (MutantRun run) { (Messages messages, Ending ending) -> void } -> void

      # Writes the run's file, as JSON in binary mode, and returns its path
      # and the path of the results' file, for the process's arguments.
      def paths: () -> [String, String]

      # The options of `Process.spawn` for the process's standard streams:
      # standard input on the null device, and standard output and standard
      # error on files in the run's folder.
      def output_options: () -> Hash[Symbol, String]

      # Whether the process has started a test: the results' file begins
      # with a whole line for a test that started. False before the process
      # opened the file.
      def started?: () -> bool

      # Hands the messages in the results' file, and `ending` with the last
      # lines of the process's standard error, to the block the run was
      # built with, and deletes the run's folder, even when the block
      # raises. A process that ended before it opened the results' file has
      # no messages.
      #
      # - `ending`: Stryker::Isolation::Ending, how the process ended.
      def land: (Ending ending) -> nil

      # Deletes the run's folder, if it is still there.
      def remove: () -> void

      private

      # The path of the results' file.
      def results_path: () -> String

      # What the process wrote to the results' file.
      def results_text: () -> String
    end
  end
end
