module Stryker
  module Isolation
    # What both adapters' `run_all` does with an exception: it stops the
    # adapter, which ends every process the adapter started, before the
    # exception leaves `run_all`, as the `Stryker::_Isolation` port
    # promises.
    #
    # ## Examples
    #
    # ```ruby
    # Stryker::Isolation::StopOnRaise.around(self) { run_each(runs, &block) }
    # ```
    module StopOnRaise
      # What `around` stops: an adapter.
      interface _Stoppable
        # Ends every process the adapter started.
        def stop: () -> void
      end

      # Runs the block, and calls `adapter.stop` when the block raises.
      # Returns nil.
      #
      # - `adapter`: what to stop, an adapter of `Stryker::_Isolation`.
      def self.around: (_Stoppable adapter) { () -> void } -> nil
    end
  end
end
