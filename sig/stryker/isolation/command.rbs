module Stryker
  module Isolation
    # How the orchestrator starts a project process: the array of
    # arguments, and the environment that holds the active mutant's ID.
    #
    # ## Examples
    #
    # ```ruby
    # argv = Stryker::Isolation::Command.for("static", cache_directory, "minitest", "7.run", "7.results")
    # Process.spawn(Stryker::Isolation::Command.environment(7), *argv)
    # ```
    module Command
      # The path of the project process's entry point.
      ENTRY: String

      # The Ruby that the entry point's process runs, with `-e`.
      MAIN: String

      # The name of the environment variable that holds the active mutant's
      # ID, `"STRYKER_ACTIVE_MUTANT"`, as `Stryker::Runtime::VARIABLE`
      # holds it. The orchestrator doesn't load the runtime, because loading
      # it starts it.
      ACTIVE_MUTANT: String

      # The arguments that start a project process: the running Ruby, the
      # entry point, `--`, and `arguments`. Ruby's own options end at `--`,
      # so the rest reach `ARGV`, which the entry point empties.
      #
      # - `arguments`: String, the mode, the cache's directory, the test
      #   runner's name, and what the mode needs.
      def self.for: (*String arguments) -> Array[String]

      # The environment that a project process starts with, over the
      # orchestrator's: `STRYKER_ACTIVE_MUTANT` set to `id`, or unset when
      # `id` is nil, whatever the orchestrator's own environment holds.
      #
      # - `id`: Integer, the active mutant's ID, or nil for none.
      def self.environment: (?Integer? id) -> Hash[String, String?]
    end
  end
end
