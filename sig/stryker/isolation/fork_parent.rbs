module Stryker
  module Isolation
    # The loop of the parent that forks, in its project process. It loads
    # the project's tests, says it is ready, and then reads runs from
    # standard input, one JSON line each, and forks a child for each run as
    # it arrives. One thread watches every child: it relays each line a
    # child writes to the orchestrator as soon as it is whole, kills a child
    # that passes its time limit, and relays how each child ended. The
    # orchestrator keeps at most `concurrency` runs in the parent, so the
    # parent has at most that many children. When the orchestrator closes
    # the parent's standard input, the parent kills every child still
    # running and ends.
    #
    # The parent runs no test, so every child starts from the same state.
    #
    # ## Examples
    #
    # The project process of `stryker run` runs it as its entry point
    # gives it:
    #
    # ```ruby
    # Stryker::Isolation::ForkParent.build(runner, ["5"]).call
    # # the process ends here
    # ```
    class ForkParent
      # The test runner adapter.
      @runner: _TestRunner

      # The parent's children.
      @children: Children

      # The writer of the lines that the orchestrator reads.
      @relay: Relay

      # The parent of a project process whose pipe to the orchestrator has
      # the file descriptor in `details`, and whose children's output files
      # go in the folder after it.
      #
      # - `runner`: Stryker::_TestRunner, the test runner adapter.
      # - `details`: Array of String, the descriptor's number as text, and
      #   the folder.
      def self.build: (_TestRunner runner, Array[String] details) -> ForkParent

      # Builds the parent.
      #
      # - `runner`: Stryker::_TestRunner, the test runner adapter.
      # - `children`: Stryker::Isolation::Children, the parent's children.
      # - `relay`: Stryker::Isolation::Relay, the writer of the lines the
      #   orchestrator reads.
      def initialize: (_TestRunner runner, Children children, Relay relay) -> void

      # Loads the tests, runs every run that comes on `input` until it
      # closes, and ends the process. A failure to load the tests reaches
      # the orchestrator as an `{"error":...}` line in place of
      # `{"ready":true}`, preceded by a `{"load_error":...}` line when the
      # project's tests raised.
      #
      # - `input`: IO, where the runs come, standard input by default. Its
      #   descriptor ends up open on the null device, so no test reads it.
      # - `finisher`: Stryker::Isolation::Finisher, what ends the process.
      def call: (?IO input, ?Finisher finisher) -> void

      private

      # Loads the tests, serves runs until the orchestrator closes the
      # parent's standard input, and then stops every child still running.
      def serve: (IO input) -> void

      # Loads the tests, tells the orchestrator that the parent is ready, and
      # returns the orders that come on `commands`.
      #
      # - `commands`: Stryker::Isolation::LineReader, the reader of the
      #   parent's standard input.
      def ready: (LineReader commands) -> Orders

      # Loads the tests through the test runner adapter, and returns them.
      # When they raise, it tells the relay, and raises the same exception
      # again.
      def loaded_tests: () -> Array[Test]
    end
  end
end
