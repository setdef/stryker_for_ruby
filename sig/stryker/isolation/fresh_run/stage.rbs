module Stryker
  module Isolation
    class FreshRun
      # A stage of a fresh run, and the stage of a run with nothing left.
      # Each stage answers the events it can take; any other event raises
      # `Stryker::Isolation::Error`, a fault of **Stryker (for Ruby)**, and
      # `stop` here does nothing.
      #
      # ## Examples
      #
      # ```ruby
      # Stryker::Isolation::FreshRun::Stage.new.stop
      # # => nil
      # Stryker::Isolation::FreshRun::Stage.new.wake_in
      # # raises Stryker::Isolation::Error
      # ```
      class Stage
        # The text of the error for an event that the stage can't take.
        UNEXPECTED: String

        # Starts the run's process with `launch`, and returns the next stage.
        #
        # - `launch`: Stryker::Isolation::FreshLaunch, what starts it.
        # - `run`: the run, a Stryker::MutantRun or the dry run.
        # - `recipe`: Stryker::TestRunners::Recipe, the test runner's recipe.
        def spawn: (FreshLaunch launch, forked run, TestRunners::Recipe recipe) -> Stage

        # The read end of the process's standard output while it is open.
        def output: () -> IO?

        # Takes the run's events, as `Stryker::Isolation::FreshRun#take` says.
        #
        # - `ready`: Array of IO, the pipes that `IO.select` found readable.
        def take: (Array[IO] ready) -> nil

        # The seconds until the run needs another look.
        def wake_in: () -> Float

        # Whether the process has been reaped, or its time is up.
        def done?: () -> bool

        # Ends the process if it still runs, reaps it, and returns the next
        # stage.
        def reap: () -> Stage

        # Hands the process's messages and how it ended to `landing`, and
        # deletes the run's folder.
        #
        # - `landing`: what judges the run.
        def land: (^(Messages messages, Ending ending) -> void landing) -> nil

        # Ends what exists of the run in this stage.
        def stop: () -> void

        private

        # Raises `Stryker::Isolation::Error` for `event`, which the stage
        # can't take.
        def unexpected: (String event) -> bot
      end
    end
  end
end
