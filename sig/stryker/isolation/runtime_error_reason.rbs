module Stryker
  module Isolation
    # The reason of a run whose status is `RuntimeError`: the error that its
    # process wrote, or else a sentence on how its process ended, how many
    # of its tests finished, and which test was running, or that it started
    # no test within `Stryker::Isolation::Timer::START_SECONDS`, and then
    # the last lines of the process's standard error.
    #
    # ## Examples
    #
    # ```ruby
    # Stryker::Isolation::RuntimeErrorReason.new(run, messages, ending).to_s
    # # => "The run's process was ended by signal SEGV after 1 of its 2 tests finished, " \
    # #    "while Shop::CartTest#test_total ran.\n[BUG] Segmentation fault ..."
    # ```
    class RuntimeErrorReason
      # The sentence for a process that ran out of time before it started a
      # test, with a `%<seconds>d` for the limit for starting.
      UNSTARTED: String

      # The run.
      @run: MutantRun

      # What the run's process said.
      @messages: Messages

      # How the run's process ended.
      @ending: Ending

      # Builds the reason.
      #
      # - `run`: Stryker::MutantRun, the run.
      # - `messages`: Stryker::Isolation::Messages, what its process said.
      # - `ending`: Stryker::Isolation::Ending, how its process ended.
      def initialize: (MutantRun run, Messages messages, Ending ending) -> void

      # The reason, on one line, or on more when the process wrote to
      # standard error.
      def to_s: () -> String

      private

      # How the process ended, as a sentence.
      def ended: () -> String
    end
  end
end
