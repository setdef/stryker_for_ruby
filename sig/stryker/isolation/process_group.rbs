module Stryker
  module Isolation
    # How a process and what it started are ended on this system. On Linux
    # and macOS, every process that an adapter starts leads a process group
    # of its own, so killing the group ends the processes that its tests
    # started too. Windows has no process groups, so there only the process
    # itself is killed.
    #
    # ## Examples
    #
    # ```ruby
    # Stryker::Isolation::ProcessGroup.kill(child_pid)
    # # => nil, whether or not anything was left to end
    # ```
    module ProcessGroup
      # What a system with process groups does: a new process leads a group
      # of its own, and a kill reaches the whole group.
      module Grouped
        # `{pgroup: true}`, for `Process.spawn`.
        def self.spawn_options: () -> Hash[Symbol, bool]

        # The group of `pid`: `-pid`, for `Process.kill`.
        #
        # - `pid`: Integer, the process ID of the group's leader.
        def self.target: (Integer pid) -> Integer

        # True: the system has process groups.
        def self.groups?: () -> bool
      end

      # What a system without process groups, such as Windows, does: a kill
      # reaches the process alone.
      module Single
        # No option, for `Process.spawn`.
        def self.spawn_options: () -> Hash[Symbol, bool]

        # `pid` itself, for `Process.kill`.
        #
        # - `pid`: Integer, the process ID.
        def self.target: (Integer pid) -> Integer

        # False: the system has no process groups.
        def self.groups?: () -> bool
      end

      # This system's way: `Grouped` where `Process.setpgid` exists, and
      # `Single` elsewhere. It comes from a lookup in place of a condition,
      # so each system takes one path through the code, and the tests cover
      # both modules on every system.
      SYSTEM: singleton(Grouped) | singleton(Single)

      # Sends KILL to the process `pid` and, where the system has groups,
      # to every process in its group, and returns nil. Nothing gentler goes
      # first: Ruby turns TERM into an exception that runs every `ensure`
      # clause and `at_exit` block, the project's included, with the mutant
      # still active. When nothing is left to end, it does nothing.
      #
      # - `pid`: Integer, the process ID.
      # - `process`: `Process`, or a stand-in in a test.
      # - `system`: `Grouped` or `Single`, `SYSTEM` unless a test passes
      #   another.
      def self.kill: (Integer pid, ?singleton(::Process) process, ?(singleton(Grouped) | singleton(Single)) system) -> nil

      # Sends KILL to what the ended process `pid` left running in its group,
      # where the system has groups, and returns nil. Without groups it does
      # nothing: nothing else is in reach, and the ID of a process that has
      # ended may belong to another process by now.
      #
      # - `pid`: Integer, the ended process's ID, its group's ID.
      # - `process`: `Process`, or a stand-in in a test.
      # - `system`: `Grouped` or `Single`, `SYSTEM` unless a test passes
      #   another.
      def self.kill_rest: (Integer pid, ?singleton(::Process) process, ?(singleton(Grouped) | singleton(Single)) system) -> nil
    end
  end
end
