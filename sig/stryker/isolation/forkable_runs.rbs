module Stryker
  module Isolation
    # The runs that `Stryker::Isolation::ForkPerRun#run_all` was given, and
    # what makes them fit for a fork parent: none is a static mutant's run,
    # which only a fresh process can run, and no two are runs of one
    # mutant. A list that breaks either rule raises ArgumentError from
    # `checked`, before any run starts.
    #
    # ## Examples
    #
    # ```ruby
    # runs = Stryker::Isolation::ForkableRuns.new(runs).checked
    # ```
    class ForkableRuns
      # The text of the error for a static mutant's run.
      STATIC: String

      # The text of the error for two runs of one mutant.
      REPEATED: String

      # The runs.
      @runs: Array[MutantRun]

      # Wraps `runs`.
      #
      # - `runs`: Array of Stryker::MutantRun.
      def initialize: (Array[MutantRun] runs) -> void

      # The runs, when a fork parent can take them. Raises ArgumentError,
      # naming the mutant, for a static mutant's run or for two runs of one
      # mutant. Either is a bug in the caller, never a fault of the project.
      def checked: () -> Array[MutantRun]

      private

      # Raises ArgumentError, naming the mutant, when two of the runs are
      # runs of one mutant.
      def refuse_repeats: () -> void
    end
  end
end
