module Stryker
  module Isolation
    # Forks a child for each run, from the parent that loaded the project's
    # code and tests, with a pipe of the child's own for what its run
    # writes. Linux and macOS have `fork`. Windows has none.
    #
    # ## Examples
    #
    # ```ruby
    # forking = Stryker::Isolation::Forking.new(streams)
    # pid, reader = forking.start(run, Stryker::Isolation::ForkedRun.new(runner, run))
    # reader.gets
    # # => "{\"started\":{...}}\n"
    # ```
    class Forking
      # What each child changes about its streams.
      @streams: ForkedStreams

      # `Process`, or a stand-in in a test.
      @process: singleton(::Process)

      # Builds the forking.
      #
      # - `streams`: Stryker::Isolation::ForkedStreams, what each child
      #   changes about its streams.
      # - `process`: `Process`, or a stand-in in a test.
      def initialize: (ForkedStreams streams, ?singleton(::Process) process) -> void

      # Forks a child that runs `run` through `child`, and returns the
      # child's process ID and the read end of its pipe. The child leads a
      # process group of its own by the time this returns, so a kill sent to
      # the group right away ends it.
      #
      # - `run`: what the child runs, such as a Stryker::MutantRun.
      # - `work`: what the child does with it, such as a
      #   Stryker::Isolation::ForkedRun.
      def start: (MutantRun run, _ForkedWork work) -> [Integer, IO]

      # What the child does right after the fork: it leads a new process
      # group, so killing the group ends what its tests start too; changes
      # its streams to the files of `run`'s output name, as
      # `Stryker::Isolation::ForkedStreams` does; and does `work`, writing
      # to `writer`. It ends the process.
      #
      # - `run`: what the child runs.
      # - `work`: what the child does with it.
      # - `writer`: IO, the child's end of its pipe.
      def child: (MutantRun run, _ForkedWork work, IO writer) -> void

      # The last lines of the standard error of the child that ran `run`.
      def errors: (MutantRun run) -> String

      private

      # Makes the child `pid` the leader of a process group of its own, and
      # returns `pid`. It changes nothing when the child has ended already.
      def grouped: (Integer pid) -> Integer
    end
  end
end
