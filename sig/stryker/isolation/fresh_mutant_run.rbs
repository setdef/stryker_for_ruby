module Stryker
  module Isolation
    # A mutant run in a fresh process, whose mutant
    # `STRYKER_ACTIVE_MUTANT` made active before anything loaded: it loads
    # the project's tests, and runs the run's tests, stopping at the first
    # that fails, as `Stryker::Isolation::ForkedRun` runs them in a forked
    # child. When the tests raise while they load, it writes
    # `{"load_error":...}` before the error that ends the run.
    #
    # ## Examples
    #
    # ```ruby
    # Stryker::Isolation::FreshMutantRun.new(runner, run).call(report)
    # ```
    class FreshMutantRun
      # The run.
      attr_reader run: MutantRun

      # The test runner adapter.
      @runner: _TestRunner

      # Builds the run.
      #
      # - `runner`: Stryker::_TestRunner, the test runner adapter.
      # - `run`: Stryker::MutantRun, the run.
      def initialize: (_TestRunner runner, MutantRun run) -> void

      # Loads the tests, runs the run's tests through `report`, and returns
      # their results.
      #
      # - `report`: Stryker::Isolation::RunReport, where each test's start
      #   and result go.
      def call: (RunReport report) -> Array[TestResult]
    end
  end
end
