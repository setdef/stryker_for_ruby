module Stryker
  module Isolation
    # Raised in the orchestrator when the project's tests raised while the
    # parent that forks loaded them, so no mutant can run. The message says
    # that the tests failed to load, gives the exception's class and
    # message, and gives the last lines of the parent's standard error when
    # it wrote any.
    #
    # The project's test helper or test files raised, so the project is
    # the one to fix them. A fault of **Stryker (for Ruby)** is a
    # `Stryker::Isolation::Error`, which `stryker run` reports as a bug.
    class TestsLoadError < StandardError
      # The text of the message, before the exception that the tests raised.
      FAILED: String

      # The text that adds the end of the parent's standard error.
      ERRORS: String

      # The error for tests that raised while they loaded.
      #
      # - `raised`: String, the exception's class and message, as the parent
      #   wrote them.
      # - `errors`: String, the last lines of the parent's standard error,
      #   empty when it wrote none.
      def self.raised: (String raised, String errors) -> TestsLoadError
    end
  end
end
