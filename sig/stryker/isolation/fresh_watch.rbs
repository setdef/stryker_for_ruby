module Stryker
  module Isolation
    # One fresh process that `Stryker::Isolation::FreshProcesses` waits on:
    # the run, the process and its waiter, and the run's time limit. A fresh
    # process has no pipe to the orchestrator, so the waiter, which
    # `Process.detach` starts, tells when it ends.
    #
    # ## Examples
    #
    # ```ruby
    # fresh = Stryker::Isolation::FreshRun.judged(run) { |result| puts(result.status) }
    # watch = Stryker::Isolation::FreshLaunch.new(cache_directory, project_root).call(fresh, Stryker::TestRunners::Recipe.new("minitest"))
    # watch.finish
    # # prints Survived
    # ```
    class FreshWatch
      # The run.
      @fresh: FreshRun

      # The process.
      @child: Child

      # The run's time limit.
      @timer: Timer

      # Starts watching.
      #
      # - `fresh`: Stryker::Isolation::FreshRun, the run.
      # - `child`: Stryker::Isolation::Child, its process.
      # - `timer`: Stryker::Isolation::Timer, its time limit.
      def initialize: (FreshRun fresh, Child child, Timer timer) -> void

      # Starts the run's time limit once its results file shows that its
      # first test started. Before then, the process has the limit for
      # starting, `Stryker::Isolation::Timer::START_SECONDS`.
      def check: () -> nil

      # Whether the run's time limit has started.
      def testing?: () -> bool

      # Whether the process has ended or its time is up, so that `finish`
      # returns at once.
      def done?: () -> bool

      # Waits at most `seconds` for the process to end.
      #
      # - `seconds`: Float, the longest wait.
      def wait: (Float seconds) -> nil

      # The seconds left before the time is up, or 0.
      def left: () -> Float

      # Waits for the process for what is left of its time, kills it if it
      # still runs, reaps it, kills what it left running in its group, and
      # lands the run.
      def finish: () -> nil

      # Kills the process and its group while it runs, or what an ended
      # process left running in its group, waits until it ended, and deletes
      # the run's folder.
      def stop: () -> void
    end
  end
end
