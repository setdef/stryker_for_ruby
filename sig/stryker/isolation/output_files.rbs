module Stryker
  module Isolation
    # The files that one project process's standard output and standard
    # error go to, in a folder of the adapter's. No result travels on either:
    # the files are there so that what the project writes lands nowhere it
    # can be mistaken for a result, and so that a `RuntimeError`'s reason
    # can end with the last lines of standard error.
    #
    # ## Examples
    #
    # ```ruby
    # outputs = Stryker::Isolation::OutputFiles.new(folder)
    # outputs.paths(7)
    # # => ["<folder>/7.out", "<folder>/7.err"]
    # outputs.tail(7)
    # # => "lib/shop/cart.rb:12:in 'total': [BUG] Segmentation fault\n..."
    # ```
    class OutputFiles
      # How many lines of standard error `tail` gives at most: 20.
      LINES: Integer

      # The folder that holds the files.
      @folder: String

      # Builds the files' names in `folder`.
      #
      # - `folder`: String, the folder.
      def initialize: (String folder) -> void

      # The paths of the standard output and the standard error of the
      # process named `name`.
      #
      # - `name`: String or Integer, the process's name in the folder, such
      #   as its mutant's ID.
      def paths: (String | Integer name) -> [String, String]

      # The last `LINES` lines of the standard error of the process named
      # `name`, with each byte that isn't valid UTF-8 replaced by U+FFFD, or
      # an empty String when the file doesn't exist.
      #
      # - `name`: String or Integer, the process's name in the folder.
      def tail: (String | Integer name) -> String
    end
  end
end
