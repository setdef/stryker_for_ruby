module Stryker
  module Isolation
    # The processes that one thread waits on at once: it waits with
    # `IO.select` on every process's pipe, and on other inputs it is given,
    # until the first deadline among the processes, and finishes each
    # process whose pipe closed or whose time is up. Ruby's `IO.select`
    # takes pipes on Linux, macOS, and Windows.
    #
    # ## Examples
    #
    # ```ruby
    # watches = Stryker::Isolation::Watches.new
    # watches.add(watch)
    # readable, ended = watches.wait([commands]) { |subject, line| relay.message(subject, line) }
    # ended.each { |subject, ending| relay.exited(subject, ending) }
    # ```
    class Watches[S]
      # Each watch, by the read end of its pipe.
      @watches: Hash[IO, Watch[S]]

      # Builds an empty set.
      def initialize: () -> void

      # Adds `watch` to the set.
      def add: (Watch[S] watch) -> nil

      # Waits until one of `inputs` or a process's pipe can be read, or
      # until the first deadline, whichever comes first. It yields each
      # whole line that a process wrote with the process's subject, and
      # finishes, and drops from the set, every process whose pipe closed or
      # whose time is up. Returns the inputs that can be read, and the
      # subject and ending of each finished process. With no inputs and no
      # process, it waits for ever.
      #
      # - `inputs`: Array of IO, other pipes to wait on.
      def wait: (Array[IO] inputs) { (S subject, String line) -> void } -> [Array[IO], Array[[S, Ending]]]

      # Stops every process in the set, as `Stryker::Isolation::Watch#stop`
      # does, and empties it.
      def stop: () -> nil

      private

      # The seconds until the first deadline among the processes, or nil
      # with no process.
      def first_deadline: () -> Float?

      # Finishes, and drops from the set, every process that is done, as
      # `Stryker::Isolation::Watch#done?` says with `ready`, and returns the
      # subject and ending of each.
      #
      # - `ready`: Array of IO, the pipes that `IO.select` found ready.
      def ended: (Array[IO] ready) { (S subject, String line) -> void } -> Array[[S, Ending]]
    end
  end
end
