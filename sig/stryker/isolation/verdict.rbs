module Stryker
  module Isolation
    # Turns how one run went into its `Stryker::MutantResult`, as
    # [How a run's outcome becomes a status](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/design/loading-and-isolation.md#how-a-runs-outcome-becomes-a-status)
    # specifies. Of the run's messages and its process's ending, the first
    # of these that holds gives the status:
    #
    # | What happened | Status | Reason |
    # | - | - | - |
    # | A test failed | `Killed` | The failure's message |
    # | The process ran past its time limit, which starts with its first test | `Timeout` | `Timeout of <N> ms exceeded.` |
    # | The run ended, every test finished without failing, and the process exited with status 0 | `Survived` | none |
    # | Anything else | `RuntimeError` | `Stryker::Isolation::RuntimeErrorReason`: the error the process wrote, or how it ended, and the end of its standard error |
    #
    # So a failed test is `Killed` whatever the process did after it said
    # so, and a process that crashed or exited before every test finished
    # is never `Survived`.
    #
    # ## Examples
    #
    # ```ruby
    # Stryker::Isolation::Verdict.new(run, messages, ending).result.status
    # # => "Killed"
    # ```
    class Verdict
      # The run.
      @run: MutantRun

      # What the run's process said.
      @messages: Messages

      # How the run's process ended.
      @ending: Ending

      # The first test that failed, or nil.
      @failure: TestResult?

      # Builds the verdict.
      #
      # - `run`: Stryker::MutantRun, the run.
      # - `messages`: Stryker::Isolation::Messages, what its process said.
      # - `ending`: Stryker::Isolation::Ending, how its process ended.
      def initialize: (MutantRun run, Messages messages, Ending ending) -> void

      # The run's result. `killed_by` holds the failed test's ID, and
      # `tests_completed` counts the tests that finished. `covered_by` is the
      # run's `covered_by`, for both kinds of mutant.
      def result: () -> MutantResult

      private

      # The status and its reason.
      def judged: () -> [String, String?]

      # The members of the result other than the mutant and the status.
      def details: () -> { killed_by: Array[String], covered_by: Array[String], tests_completed: Integer, duration_ms: Float, static: bool }

      # The ID of the test that failed, or none.
      def killed_by: () -> Array[String]

      # Whether the run ran past its time limit, which starts with its
      # first test. A run that no test started never times out.
      def timed_out?: () -> bool

      # Whether the run survived.
      def survived?: () -> bool
    end
  end
end
