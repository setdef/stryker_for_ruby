module Stryker
  module Isolation
    # Reads lines from a pipe without waiting, so one thread can read many
    # pipes as `IO.select` finds them ready. Each line it yields ends with a
    # line break. What follows the last line break waits for the rest of its
    # line, and a line that never gets its line break is never yielded: the
    # process that wrote it didn't finish writing it.
    #
    # ## Examples
    #
    # ```ruby
    # reader = Stryker::Isolation::LineReader.new(pipe)
    # reader.read { |line| puts(line) }
    # # => :more, :idle, or :closed
    # ```
    class LineReader
      # How many bytes one read takes at most.
      CHUNK: Integer

      # The pipe.
      attr_reader io: IO

      # What arrived after the last line break.
      @pending: String

      # Builds the reader.
      #
      # - `io`: IO, the pipe to read.
      def initialize: (IO io) -> void

      # Reads what is in the pipe now, yields each whole line, and returns
      # `:more` when it read something, `:idle` when the pipe was empty, and
      # `:closed` when every writer has closed the pipe.
      def read: () { (String line) -> void } -> (:more | :idle | :closed)

      # Reads and yields lines until the pipe is empty or closed, without
      # waiting for more.
      def drain: () { (String line) -> void } -> void

      # Closes the pipe.
      def close: () -> nil

      private

      # Adds `chunk` to what is pending, and yields each line that it
      # completes.
      def add: (String chunk) { (String line) -> void } -> void
    end
  end
end
