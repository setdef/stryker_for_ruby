module Stryker
  module Isolation
    # What turns a mutant run, the messages its child wrote, and how the
    # child ended into the run's result. `Stryker::Isolation::Verdict` is
    # one.
    interface _Judge
      # The result of `run`.
      #
      # - `run`: Stryker::MutantRun, the run.
      # - `messages`: Stryker::Isolation::Messages, what the child wrote.
      # - `ending`: Stryker::Isolation::Ending, how the child ended.
      def call: (MutantRun run, Messages messages, Ending ending) -> MutantResult
    end

    # One run that the orchestrator gave the parent that forks, from then
    # until the parent says how its child ended: the run, its child's
    # process ID once the parent says it, and the messages the child wrote.
    # Its judge turns them into the run's result.
    #
    # ## Examples
    #
    # ```ruby
    # flight = Stryker::Isolation::Flight.new(run, Stryker::Isolation::Verdict)
    # flight.receive({ "forked" => 4242 })
    # # => nil
    # flight.receive({ "exited" => { "exit_status" => 0, "signal" => nil, "timed_out" => false, "duration_ms" => 3.1, "errors" => "" } })
    # # => #<data Stryker::MutantResult ...>
    # ```
    class Flight
      # The kinds of line that the parent writes about a run, each the key
      # of its line beside the run's relay key: `"forked"`, `"message"`, and
      # `"exited"`.
      KINDS: Array[String]

      # The run.
      @run: MutantRun

      # What turns the run's messages and ending into its result.
      @judge: _Judge

      # The child's process ID, once the parent says it.
      @pid: Integer?

      # The messages the child wrote, as the parent relayed them.
      @objects: Array[JsonValue::json_value]

      # Builds the flight.
      #
      # - `run`: Stryker::MutantRun, the run.
      # - `judge`: what turns the run's messages and ending into its result,
      #   such as `Stryker::Isolation::Verdict`.
      def initialize: (MutantRun run, _Judge judge) -> void

      # Takes one line that the parent wrote about the run, and returns the
      # run's result once the line says how the child ended, or nil before
      # that. Raises `Stryker::Isolation::Error` for a line of a kind it
      # doesn't know, or an ending that isn't one.
      #
      # - `object`: Hash, the line without its run's relay key, whose one key is
      #   `"forked"`, `"message"`, or `"exited"`.
      def receive: (Hash[String, JsonValue::json_value] object) -> MutantResult?

      # Kills the child's process group, when the parent said which child
      # runs the run, for a parent that couldn't end its children.
      def kill: () -> nil

      private

      # Keeps what a line that isn't the ending says: the child's process ID,
      # or one of its messages.
      #
      # - `kind`: String, the line's key, or nil for an empty line.
      # - `value`: the line's value.
      def record: (String? kind, JsonValue::json_value value) -> void

      # The run's result, from its messages and `ending`, as the judge gives
      # it.
      def verdict: (JsonValue::json_value ending) -> MutantResult

      # The run's relay key as JSON, which names the run in an error.
      def about: () -> String
    end
  end
end
