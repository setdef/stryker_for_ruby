module Stryker
  module Isolation
    # One run that the orchestrator gave the parent that forks, from then
    # until the parent says how its child ended: the run, its child's
    # process ID once the parent says it, and the messages the child wrote.
    # When it is told to land, it hands those messages and how the child
    # ended to the block it was built with, which judges the run.
    #
    # ## Examples
    #
    # ```ruby
    # flight = Stryker::Isolation::Flight.new(run) { |messages, ending| puts(ending.exit_status) }
    # flight.receive({ "forked" => 4242 })
    # # => nil
    # ending = flight.receive({ "exited" => { "exit_status" => 0, "signal" => nil, "timed_out" => false, "duration_ms" => 3.1, "errors" => "" } })
    # flight.land(ending)
    # # prints 0
    # ```
    class Flight
      # The kinds of line that the parent writes about a run, each the key
      # of its line beside the run's relay key: `"forked"`, `"message"`, and
      # `"exited"`.
      KINDS: Array[String]

      # The run.
      attr_reader run: forked

      # The flight of the mutant run `run`, which yields the run's result,
      # as `Stryker::Isolation::Verdict` gives it, when it lands.
      #
      # - `run`: Stryker::MutantRun, the run.
      def self.judged: (MutantRun run) { (MutantResult result) -> void } -> Flight

      # What judges the run from its child's messages and ending.
      @landing: ^(Messages messages, Ending ending) -> void

      # The child's process ID, once the parent says it.
      @pid: Integer?

      # The messages the child wrote, as the parent relayed them.
      @objects: Array[JsonValue::json_value]

      # Builds the flight.
      #
      # - `run`: the run, a Stryker::MutantRun or the dry run.
      # - the block: what judges the run, given the child's messages and how
      #   the child ended, when the flight lands.
      def initialize: (forked run) { (Messages messages, Ending ending) -> void } -> void

      # Takes one line that the parent wrote about the run, and returns how
      # the child ended once the line says it, or nil before that. Raises
      # `Stryker::Isolation::Error` for a line of a kind it doesn't know, or
      # an ending that isn't one.
      #
      # - `object`: Hash, the line without its run's relay key, whose one key is
      #   `"forked"`, `"message"`, or `"exited"`.
      def receive: (Hash[String, JsonValue::json_value] object) -> Ending?

      # Hands the messages the child wrote, and `ending`, to the block the
      # flight was built with, and returns what nothing needs.
      #
      # - `ending`: Stryker::Isolation::Ending, how the child ended, as
      #   `receive` returned it.
      def land: (Ending ending) -> nil

      # Kills the child's process group, when the parent said which child
      # runs the run, for a parent that couldn't end its children.
      def kill: () -> nil

      private

      # Keeps what a line that isn't the ending says: the child's process ID,
      # or one of its messages.
      #
      # - `kind`: String, the line's key, or nil for an empty line.
      # - `value`: the line's value.
      def record: (String? kind, JsonValue::json_value value) -> void

      # How the child ended, from the line's `value`.
      def ending: (JsonValue::json_value value) -> Ending

      # The run's relay key as JSON, which names the run in an error.
      def about: () -> String
    end
  end
end
