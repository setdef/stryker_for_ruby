module Stryker
  module Isolation
    # What one run's process said, as the orchestrator reads it: each
    # test's start and result, the end of the run, and the error that
    # stopped it. A message is a JSON object with one key: `"started"` with
    # a `Stryker::Test`, `"finished"` with a `Stryker::TestResult`,
    # `"ended"`, or `"error"` with a String.
    #
    # It keeps the messages up to the first object that is no message, and
    # nothing after it, because nothing after it can be trusted to be what
    # the run's process wrote.
    #
    # ## Examples
    #
    # ```ruby
    # messages = Stryker::Isolation::Messages.parse(File.read(results_path))
    # messages.results.map(&:status)
    # # => ["passed", "failed"]
    # messages.ended?
    # # => true
    # ```
    class Messages
      # What a message holds once it is read: a test that started, a test's
      # result, `true` for the end of the run, or the error that stopped it.
      type value = Test | TestResult | String | bool

      # How each kind of message reads its value.
      READERS: Hash[String, Proc]

      # The messages of the lines of `text`. A last line with no line break
      # is one the process didn't finish writing, and is left out.
      #
      # - `text`: String, the lines the process wrote.
      def self.parse: (String text) -> Messages

      # The object that `line` holds as JSON, or `line` itself when it
      # isn't JSON, which is no message.
      #
      # - `line`: String, one line.
      def self.object: (String line) -> JsonValue::json_value

      # The value of the message `object`, or nil when it is no message.
      #
      # - `object`: what one line holds.
      def self.read: (JsonValue::json_value object) -> value?

      # The tests that started, in order.
      @tests: Array[Test]

      # The results of the tests that finished, in order.
      @results: Array[TestResult]

      # The errors the process wrote.
      @errors: Array[String]

      # Whether the process said that its run ended.
      @ended: bool

      # Reads the messages.
      #
      # - `objects`: Array, the objects that the process wrote, in order.
      def initialize: (Array[JsonValue::json_value] objects) -> void

      # Each finished test's result, in order.
      attr_reader results: Array[TestResult]

      # Whether the process said that its run ended.
      def ended?: () -> bool

      # The error that stopped the run, as the process wrote it, or nil.
      def error: () -> String?

      # The test that started last, when it never finished, or nil.
      def unfinished: () -> Test?

      private

      # Keeps `value` with the messages of its kind, and returns nil when it
      # is no message's value.
      def sort: (value? value) -> (Array[Test] | Array[TestResult] | Array[String] | bool | nil)
    end
  end
end
