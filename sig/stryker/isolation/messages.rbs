module Stryker
  module Isolation
    # What one run's process said, as the orchestrator reads it: each
    # test's start and result, the end of the run, and the error that
    # stopped it, each read as `Stryker::Isolation::Message` reads it.
    #
    # It keeps the messages up to the first object that is no message, and
    # nothing after it, because nothing after it can be trusted to be what
    # the run's process wrote.
    #
    # ## Examples
    #
    # ```ruby
    # messages = Stryker::Isolation::Messages.parse(File.read(results_path))
    # messages.results.map(&:status)
    # # => ["passed", "failed"]
    # messages.ended?
    # # => true
    # ```
    class Messages
      # The messages of the lines of `text`. A last line with no line break
      # is one the process didn't finish writing, and is left out.
      #
      # - `text`: String, the lines the process wrote.
      def self.parse: (String text) -> Messages

      # The value of each message, up to the first object that is no
      # message.
      @values: Array[Message::value]

      # Reads the messages.
      #
      # - `objects`: Array, the objects that the process wrote, in order.
      def initialize: (Array[JsonValue::json_value] objects) -> void

      # Each finished test's result, in order.
      def results: () -> Array[TestResult]

      # The result of the first test that failed, or nil.
      def failure: () -> TestResult?

      # Whether the process said that its run ended.
      def ended?: () -> bool

      # Whether the process said that a test started.
      def tests_started?: () -> bool

      # The error that stopped the run, as the process wrote it, or nil.
      def error: () -> String?

      # The test that started last, when it never finished, or nil.
      def unfinished: () -> Test?

      private

      # Keeps `value` and returns true, or returns false when it is no
      # message's value, which ends the messages.
      def kept?: (Message::value? value) -> bool
    end
  end
end
