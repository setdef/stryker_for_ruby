module Stryker
  module Isolation
    # The `Stryker::_DryRunIsolation` adapter that gives each run a fresh
    # process, on Linux, macOS, and Windows, as
    # [Static mutants on every system](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/contributors/design/loading-and-isolation.md#static-mutants-on-every-system)
    # specifies. Each run gets a fresh project process, with its mutant
    # named in `STRYKER_ACTIVE_MUTANT` before the process starts, so the
    # mutant's switch takes the mutated branch while its file loads. The
    # process loads the project's code and tests, runs the run's tests, and
    # writes each test's start and result to a file as it happens. The
    # adapter keeps up to `concurrency` processes running at once, learns
    # that each ended from a `Process.detach` waiter, kills a process that
    # runs past its time limit, and judges each run from its file once its
    # process ended.
    #
    # A static mutant needs such a process on every system. A runtime
    # mutant's run works here too, at the cost of a fresh process for each
    # run, and so does the dry run, in a fresh process with no mutant
    # active, which records the hits made while the project loads in its
    # static bucket, and each test's in that test's bucket, as
    # [The dry run](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/contributors/design/coverage.md#the-dry-run)
    # specifies.
    #
    # ## Examples
    #
    # ```ruby
    # isolation = Stryker::Isolation::FreshProcesses.new(cache_directory, project_root)
    # isolation.start(config)
    # begin
    #   found = isolation.dry_run(config)
    #   isolation.run_all(runs) { |result| reporter.call(Stryker::Events::MutantTested.new(result:)) }
    # ensure
    #   isolation.stop
    # end
    # ```
    class FreshProcesses
      # The text of the error for runs before `start`.
      UNSTARTED: String

      # What starts each process.
      @launch: FreshLaunch

      # The options of the run, from `start`.
      @config: Config?

      # The processes still running.
      @running: FreshWatches

      # Builds the adapter.
      #
      # - `directory`: String, the cache's directory.
      # - `root`: String, the project's root, the current folder by
      #   default.
      # - `launch`: Stryker::Isolation::FreshLaunch, what starts each
      #   process, or a stand-in in a test.
      def initialize: (String directory, ?String root, ?FreshLaunch launch) -> void

      # Keeps `config`.
      def start: (Config config) -> nil

      # Runs every run, and yields each result as it arrives. Raises
      # `Stryker::Isolation::Error` before `start`. When it raises, or the
      # block does, it kills every process still running, waits until each
      # ended, and deletes their folders.
      def run_all: (Array[MutantRun] runs) { (MutantResult result) -> void } -> void

      # Runs the dry run in a fresh process, which loads the project's code
      # and tests with no mutant active, runs every test once, stopping
      # after the first that fails, and then runs the loading check.
      # Returns what the dry run found. The dry run's tests have
      # `config.dry_run_timeout_minutes` from the start of the first test,
      # and the process has `Stryker::Isolation::Timer::START_SECONDS` to
      # start it.
      #
      # Raises `Stryker::Isolation::DryRunError` when a test failed, the
      # loading check failed, the process crashed or raised, or the tests
      # ran past the limit, in which case the message names
      # `dryRunTimeoutMinutes`, as `Stryker::Isolation::ForkPerRun#dry_run`
      # raises it. Raises `Stryker::Isolation::Error` before `start`. Calls
      # `stop` when it raises.
      #
      # - `config`: Stryker::Config, whose `dry_run_timeout_minutes` limits
      #   the tests.
      def dry_run: (Config config) -> DryRunResult

      # Kills every process still running, waits until each ended, and
      # deletes their folders.
      def stop: () -> nil

      private

      # Runs `fresh`, as `run_all` says, until it lands.
      def land: (FreshRun fresh) -> void

      # Runs the fresh run that the block gives for each of `runs`, as
      # `run_all` says. Raises `Stryker::Isolation::Error` before `start`.
      def fly: [R] (Array[R] runs) { (R run) -> FreshRun } -> void

      # What starts the process of the fresh run that `fresh` gives for a
      # run, with the test runner that `recipe` describes.
      def launcher: [R] (TestRunners::Recipe recipe, ^(R run) -> FreshRun fresh) -> ^(R run) -> FreshWatch
    end
  end
end
