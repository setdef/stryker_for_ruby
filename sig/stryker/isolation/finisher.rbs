module Stryker
  module Isolation
    # Ends a project process once its work is done, with `exit!`, and never
    # with `exit`: `exit` runs every `at_exit` block, the project's
    # included, such as the one `minitest/autorun` registers or the one
    # SimpleCov registers, which writes into the project. A forked child, a
    # fresh process for a static mutant, and the parent that forks all end
    # this way.
    #
    # ## Examples
    #
    # ```ruby
    # Stryker::Isolation::Finisher.new.call(report) do
    #   runner.run(run.test_ids, bail: true, observer: report)
    # end
    # # the process ends with status 0, or 1 when the block raised
    # ```
    class Finisher
      # What ends the process: `Process`, or a stand-in in a test.
      @process: singleton(::Process)

      # Builds the finisher.
      #
      # - `process`: `Process`, or a stand-in in a test, whose `exit!` ends
      #   the process.
      def initialize: (?singleton(::Process) process) -> void

      # Runs the block through `report.conclude`, which writes how it
      # ended, and then ends the process with `exit!`: with status 0 when
      # the block finished, and 1 when it raised, or when `conclude` let an
      # exception through, such as `Interrupt`.
      #
      # - `report`: Stryker::Isolation::_Report, the writer of the
      #   process's lines.
      def call: (_Report report) { () -> void } -> void
    end
  end
end
