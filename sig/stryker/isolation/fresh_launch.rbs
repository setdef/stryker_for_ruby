module Stryker
  module Isolation
    # Starts the fresh process of one run, in the project's folder, with
    # `STRYKER_ACTIVE_MUTANT` set to the run's active mutant, or unset,
    # before the process starts, its standard input on the null device, and
    # its standard output and standard error on files in the run's own
    # folder. Where the system has process groups, the process leads a
    # group of its own.
    #
    # ## Examples
    #
    # ```ruby
    # launch = Stryker::Isolation::FreshLaunch.new(cache_directory, project_root)
    # watch = launch.call(Stryker::Isolation::FreshRun.judged(run) { |result| puts(result.status) }, "minitest")
    # ```
    class FreshLaunch
      # The cache's directory.
      @directory: String

      # The project's root, where the process runs.
      @root: String

      # `Process`, or a stand-in in a test.
      @process: singleton(::Process)

      # Builds the launch.
      #
      # - `directory`: String, the cache's directory.
      # - `root`: String, the project's root.
      # - `process`: `Process`, or a stand-in in a test.
      def initialize: (String directory, String root, ?singleton(::Process) process) -> void

      # Starts the process of `fresh`, with the mutant that its run needs
      # active, and returns the watch over it, with the run's time limit
      # starting now.
      #
      # - `fresh`: Stryker::Isolation::FreshRun, the run.
      # - `runner`: String, the test runner's name.
      def call: (FreshRun fresh, String runner) -> FreshWatch

      private

      # Spawns the process of `fresh`, and returns its process ID.
      def spawn: (FreshRun fresh, String runner) -> Integer
    end
  end
end
