module Stryker
  module Isolation
    # How the process of one mutant run ended: its exit status or the
    # signal that ended it, whether it ran past its time limit, and how long
    # it ran. The process that watched it makes one, and the orchestrator
    # judges the run from it and the run's messages. It converts to and from
    # JSON, as `Stryker::JsonValue` says, because the parent that forks
    # sends it to the orchestrator.
    #
    # ## Examples
    #
    # ```ruby
    # ending = Stryker::Isolation::Ending.new(exit_status: nil, signal: "KILL", timed_out: true, duration_ms: 1502.4, errors: "")
    # ending.description
    # # => "was ended by signal KILL"
    # ending.clean?
    # # => false
    # ```
    class Ending < Data
      include JsonValue
      extend JsonValue::Reading[Ending]

      # What `Stryker::Isolation::Ending.of` reads a status from:
      # `Process::Status`, or a stand-in with these two methods.
      interface _Status
        # The exit status, or nil when a signal ended the process.
        def exitstatus: () -> Integer?

        # The number of the signal that ended the process, or nil.
        def termsig: () -> Integer?
      end

      # The process's exit status, or nil when a signal ended it.
      attr_reader exit_status: Integer?

      # The name of the signal that ended the process, such as `"KILL"`,
      # or nil when it exited.
      attr_reader signal: String?

      # Whether the process was still running when its time limit passed,
      # so that it was killed.
      attr_reader timed_out: bool

      # How long the process ran, in milliseconds.
      attr_reader duration_ms: Float

      # The last lines that the process wrote to its standard error, as
      # `Stryker::Isolation::OutputFiles#tail` gives them, or an empty String.
      attr_reader errors: String

      # The ending of a process with `status`, with no lines of standard
      # error. Add them with `with(errors:)`.
      #
      # - `status`: Stryker::Isolation::Ending::_Status, the status of the
      #   ended process, such as a `Process::Status`.
      # - `timed_out`: bool, whether it ran past its time limit.
      # - `duration_ms`: Float, how long it ran, in milliseconds.
      def self.of: (_Status status, timed_out: bool, duration_ms: Float) -> Ending

      # Builds the ending.
      def self.new: (exit_status: Integer?, signal: String?, timed_out: bool, duration_ms: Float, errors: String) -> instance
                  | (Integer? exit_status, String? signal, bool timed_out, Float duration_ms, String errors) -> instance

      # Whether the process exited with status 0.
      def clean?: () -> bool

      # How the process ended, as words that follow "The run's process":
      # `"exited with status 3"`, or `"was ended by signal SEGV"`.
      def description: () -> String
    end
  end
end
