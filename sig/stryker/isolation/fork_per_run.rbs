module Stryker
  module Isolation
    # The `Stryker::_Isolation` adapter for runtime mutants on Linux and
    # macOS, as
    # [Forking on Linux and macOS](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/contributors/design/loading-and-isolation.md#forking-on-linux-and-macos)
    # specifies. `start` starts a project process, the parent, which loads
    # the project's code and tests once and runs no test. `run_all` gives
    # the parent each run, keeping at most `concurrency` in it at once, and
    # the parent forks a child for each, which makes the run's mutant
    # active, runs the run's tests, and ends with `exit!`. The parent kills
    # a child that runs past its time limit. Each test's result reaches the
    # orchestrator as soon as the test finishes, and
    # `Stryker::Isolation::Verdict` judges the run from those lines.
    #
    # It runs no static mutant: a static mutant's switch runs only while
    # its file loads, and a child's code loaded in the parent before any
    # mutant was active. Windows has no `fork`, so the adapter doesn't run
    # there.
    #
    # ## Examples
    #
    # ```ruby
    # isolation = Stryker::Isolation::ForkPerRun.new(cache_directory, project_root)
    # isolation.start(config)
    # begin
    #   found = isolation.dry_run(config)
    #   isolation.run_all(runtime_runs) { |result| reporter.call(Stryker::Events::MutantTested.new(result:)) }
    # ensure
    #   isolation.stop
    # end
    # ```
    class ForkPerRun
      # The text of the error for a static mutant's run.
      STATIC: String

      # The text of the error for `run_all` before `start`.
      UNSTARTED: String

      # What starts the parent.
      @launch: ParentLaunch

      # The parent and its runs, between `start` and `stop`.
      @flights: Flights?

      # Builds the adapter.
      #
      # - `directory`: String, the cache's directory.
      # - `root`: String, the project's root, the current folder by
      #   default.
      # - `launch`: Stryker::Isolation::ParentLaunch, what starts the
      #   parent, or a stand-in in a test.
      def initialize: (String directory, ?String root, ?ParentLaunch launch) -> void

      # Starts the parent, and waits until it has loaded the tests, for at
      # most `Stryker::Isolation::ParentProcess::LOAD_SECONDS`. Raises
      # `Stryker::Isolation::Error` when it ends first or takes longer, as
      # `Stryker::Isolation::ParentProcess#await_ready` says.
      def start: (Config config) -> nil

      # Runs every run, and yields each result as it arrives. Raises
      # ArgumentError, before it runs any, for a static mutant's run, and
      # `Stryker::Isolation::Error` when the parent ends or writes what no
      # parent writes, or before `start`. Calls `stop` when it raises, or
      # when the block does.
      def run_all: (Array[MutantRun] runs) { (MutantResult result) -> void } -> void

      # Runs the dry run in a child of the parent, which runs every test that
      # the parent loaded once, with no mutant active, stopping after the
      # first that fails, and then runs the loading check. Returns what the
      # dry run found. The child inherits the static bucket that the parent
      # filled while it loaded the project, so the dry run starts from the
      # state that every mutant run starts from. The dry run's tests have
      # `config.dry_run_timeout_minutes` from the start of the first test.
      #
      # Raises `Stryker::Isolation::DryRunError` when a test failed, the
      # loading check failed, the child crashed or raised, or the tests ran
      # past the limit, in which case the message names
      # `dryRunTimeoutMinutes`. Raises `Stryker::Isolation::Error` when the
      # parent ends or writes what no parent writes, or before `start`.
      # Calls `stop` when it raises, so no mutant runs after a dry run that
      # failed.
      #
      # - `config`: Stryker::Config, whose `dry_run_timeout_minutes` limits
      #   the tests.
      def dry_run: (Config config) -> DryRunResult

      # Ends the parent, its children, and what the project's code started
      # in the parent's group, and waits until the parent ended.
      def stop: () -> nil

      private

      # Lands every flight of `list` through the flights, and calls `stop`
      # when that raises. Raises `Stryker::Isolation::Error` before `start`.
      def fly: (Array[Flight] list) -> void
    end
  end
end
