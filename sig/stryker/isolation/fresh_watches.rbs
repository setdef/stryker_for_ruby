module Stryker
  module Isolation
    # The fresh runs that `Stryker::Isolation::FreshProcesses` runs at once,
    # and the one wait for all of them: `IO.select` on the pipe of each
    # process's standard output, which ends when the process does, with a
    # timeout at the soonest look that a run needs, its deadline or a short
    # poll.
    #
    # ## Examples
    #
    # ```ruby
    # watches = Stryker::Isolation::FreshWatches.new
    # fresh = Stryker::Isolation::FreshRun.judged(run, Stryker::Isolation::FreshFolder.made) { |result| puts(result.status) }
    # watches.add(fresh)
    # fresh.launch(launch, Stryker::TestRunners::Recipe.new("minitest"))
    # watches.finish until watches.empty?
    # ```
    class FreshWatches
      # `IO`, whose `select` waits, or a stand-in in a test.
      @io: singleton(IO)

      # The runs whose processes the set waits on.
      @watches: Array[FreshRun]

      # Builds an empty set.
      #
      # - `io`: `IO`, or a stand-in in a test.
      def initialize: (?singleton(IO) io) -> void

      # Adds `watch`.
      def add: (FreshRun watch) -> nil

      # How many runs the set holds.
      def size: () -> Integer

      # Whether the set holds no run.
      def empty?: () -> bool

      # Calls the block for each of `runs`, while fewer than `window`
      # runs are in the set, and finishes the runs, as `finish` does,
      # until every run has started and every run has finished. The block
      # adds the run to the set and starts it, so that `stop` ends whatever
      # exists of a run whose start a signal or an error ends.
      #
      # - `runs`: Array, the runs, in the order they start.
      # - `window`: Integer, the most runs in the set at once.
      def run: [R] (Array[R] runs, Integer window) { (R run) -> void } -> void

      # Waits until a process writes to its pipe or ends, or the soonest run
      # needs a look, then has each run take what happened, and finishes each
      # run whose process has been reaped or has run out of time, which lands
      # it, and drops it from the set once it has landed, so that a signal
      # while it finishes finds it there, and `stop` ends it. May finish none.
      # An empty set waits for nothing.
      def finish: () -> void

      # Kills every process still running, waits until each ended, deletes
      # their folders, and empties the set. A run that raises as it stops
      # leaves every other run stopped, and the first error reaches the
      # caller once all have stopped. A signal ends the stop at once, and
      # leaves the set empty all the same.
      def stop: () -> nil

      private

      # Finishes `watch`, and then drops it from the set.
      def land: (FreshRun watch) -> void

      # Waits, as `finish` says, and returns the pipes that are readable.
      def wait: () -> Array[IO]
    end
  end
end
