module Stryker
  module Isolation
    # The fresh processes that `Stryker::Isolation::FreshProcesses` waits on.
    # A fresh process has no pipe to the orchestrator, so the set learns
    # that one ended from its waiter, which `Process.detach` starts.
    #
    # ## Examples
    #
    # ```ruby
    # watches = Stryker::Isolation::FreshWatches.new
    # watches.add(launch.call(run, "minitest"))
    # watches.finish { |result| puts(result.status) }
    # ```
    class FreshWatches
      # The processes still running.
      @watches: Array[FreshWatch]

      # Builds an empty set.
      def initialize: () -> void

      # Adds `watch`.
      def add: (FreshWatch watch) -> nil

      # How many processes the set waits on.
      def size: () -> Integer

      # Whether the set waits on no process.
      def empty?: () -> bool

      # Yields the result of each process that has ended, and drops it from
      # the set. With none ended, it waits on the process whose time ends
      # first, until that process ends or its time does, and yields its
      # result.
      def finish: () { (MutantResult result) -> void } -> void

      # Kills every process still running, waits until each ended, deletes
      # their folders, and empties the set.
      def stop: () -> nil
    end
  end
end
