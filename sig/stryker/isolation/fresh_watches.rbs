module Stryker
  module Isolation
    # The fresh processes that `Stryker::Isolation::FreshProcesses` waits on.
    # A fresh process has no pipe to the orchestrator, so the set learns
    # that one ended from its waiter, which `Process.detach` starts.
    #
    # ## Examples
    #
    # ```ruby
    # watches = Stryker::Isolation::FreshWatches.new
    # watches.add(launch.call(Stryker::Isolation::FreshRun.judged(run) { |result| puts(result.status) }, "minitest"))
    # watches.finish
    # ```
    class FreshWatches
      # The longest wait, in seconds, while a process hasn't started a test:
      # a process writes the start of its first test only to its results
      # file, so the set looks there this often, and a run's time limit starts
      # at most this much after its first test does.
      POLL_SECONDS: Float

      # The processes still running.
      @watches: Array[FreshWatch]

      # Builds an empty set.
      def initialize: () -> void

      # Adds `watch`.
      def add: (FreshWatch watch) -> nil

      # How many processes the set waits on.
      def size: () -> Integer

      # Whether the set waits on no process.
      def empty?: () -> bool

      # Starts a watch for each of `runs`, from the block, while fewer than
      # `window` watches are in the set, and finishes them, as `finish`
      # does, until every run has started and every watch has finished.
      #
      # - `runs`: Array, the runs, in the order they start.
      # - `window`: Integer, the most watches in the set at once.
      def run: [R] (Array[R] runs, Integer window) { (R run) -> FreshWatch } -> void

      # Starts the time limit of each run whose first test has started, then
      # finishes each process that has ended or run out of time, which lands
      # its run, and drops it from the set once it has landed, so that a
      # signal while it finishes finds it there, and `stop` ends it. With none
      # of them, it first waits on the process whose time ends first, until
      # that process ends or its time does, or for at most `POLL_SECONDS` while
      # any run hasn't started a test, and may finish none.
      def finish: () -> void

      # Waits, as `finish` says, for the process whose time ends first.
      def pause: () -> nil

      # Kills every process still running, waits until each ended, deletes
      # their folders, and empties the set.
      def stop: () -> nil
    end
  end
end
