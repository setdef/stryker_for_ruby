module Stryker
  module Isolation
    # What a forked child does with its run: it makes the run's mutant
    # active, runs the run's tests through the test runner adapter,
    # stopping at the first that fails, and writes each test's start and
    # result to its pipe as it happens. Then it ends the child with `exit!`.
    #
    # ## Examples
    #
    # ```ruby
    # Stryker::Isolation::ForkedRun.new(runner, run).call(writer)
    # # the child ends here
    # ```
    class ForkedRun
      # The test runner adapter, with the tests loaded in the parent.
      @runner: _TestRunner

      # The run.
      @run: MutantRun

      # What ends the child.
      @finisher: Finisher

      # What makes the mutant active: `Stryker::Runtime`, or a stand-in in
      # a test.
      @runtime: singleton(Runtime)

      # Builds the run's work.
      #
      # - `runner`: Stryker::_TestRunner, the adapter whose tests the parent
      #   loaded.
      # - `run`: Stryker::MutantRun, the run.
      # - `finisher`: Stryker::Isolation::Finisher, what ends the child.
      # - `runtime`: `Stryker::Runtime`, or a stand-in in a test.
      def initialize: (_TestRunner runner, MutantRun run, ?Finisher finisher, ?singleton(Runtime) runtime) -> void

      # Runs the run in this process, writes what happens to `writer`, and
      # ends the process.
      #
      # - `writer`: IO, the child's end of its pipe to the parent.
      def call: (IO writer) -> void
    end
  end
end
