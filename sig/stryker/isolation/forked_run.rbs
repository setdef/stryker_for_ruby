module Stryker
  module Isolation
    # What a forked child does with its run: it makes the run's mutant
    # active, runs the run's tests through the test runner adapter,
    # stopping at the first that fails, and writes each test's start and
    # result to its pipe as it happens. `Stryker::Isolation::Forking` ends
    # the child once the run is done.
    #
    # ## Examples
    #
    # ```ruby
    # Stryker::Isolation::ForkedRun.new(runner, run).call(report)
    # ```
    class ForkedRun
      # The test runner adapter, with the tests loaded in the parent.
      @runner: _TestRunner

      # The run.
      @run: MutantRun

      # What makes the mutant active: `Stryker::Runtime`, or a stand-in in
      # a test.
      @runtime: singleton(Runtime)

      # Builds the run's work.
      #
      # - `runner`: Stryker::_TestRunner, the adapter whose tests the parent
      #   loaded.
      # - `run`: Stryker::MutantRun, the run.
      # - `runtime`: `Stryker::Runtime`, or a stand-in in a test.
      def initialize: (_TestRunner runner, MutantRun run, ?singleton(Runtime) runtime) -> void

      # Makes the run's mutant active and runs the run's tests, stopping at
      # the first that fails, through `report`, and returns their results.
      #
      # - `report`: Stryker::Isolation::RunReport, where each test's start
      #   and result go.
      def call: (RunReport report) -> Array[TestResult]
    end
  end
end
