module Stryker
  module Isolation
    # What the dry run's forked child does: it starts the dry run's
    # recording of hits, with a collector of the child's own, runs every
    # test through `Stryker::Runtime::DryRunTests`, writing each test's
    # start and result to its pipe as it happens, and then writes the whole
    # `Stryker::DryRunResult` on a line of its own, `{"result":{...}}`,
    # before `{"ended":true}`. A failed loading check, or anything else the
    # run raises, is the run's `{"error":...}` line instead. Then it ends
    # the child with `exit!`.
    #
    # ## Examples
    #
    # ```ruby
    # Stryker::Isolation::ForkedDryRun.new(Stryker::Runtime::DryRunTests.new(runner, test_ids)).call(writer)
    # # the child ends here
    # ```
    class ForkedDryRun
      # What runs every test and returns what the dry run found.
      @tests: Runtime::DryRunTests

      # What ends the child.
      @finisher: Finisher

      # What starts the dry run's recording: `Stryker::Runtime`, or a
      # stand-in in a test.
      @runtime: singleton(Runtime)

      # Builds the dry run's work.
      #
      # - `tests`: Stryker::Runtime::DryRunTests, what runs every test.
      # - `finisher`: Stryker::Isolation::Finisher, what ends the child.
      # - `runtime`: `Stryker::Runtime`, or a stand-in in a test.
      def initialize: (Runtime::DryRunTests tests, ?Finisher finisher, ?singleton(Runtime) runtime) -> void

      # Runs the dry run in this process, writes what happens to `writer`,
      # and ends the process.
      #
      # - `writer`: IO, the child's end of its pipe to the parent.
      def call: (IO writer) -> void
    end
  end
end
