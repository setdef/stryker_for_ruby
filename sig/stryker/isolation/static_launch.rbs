module Stryker
  module Isolation
    # Starts the fresh process of one run, in the project's folder, with
    # `STRYKER_ACTIVE_MUTANT` set to the run's mutant before the process
    # starts, its standard input on the null device, and its standard output
    # and standard error on files in the run's own folder. Where the system
    # has process groups, the process leads a group of its own.
    #
    # ## Examples
    #
    # ```ruby
    # launch = Stryker::Isolation::StaticLaunch.new(cache_directory, project_root)
    # watch = launch.call(run, "minitest")
    # ```
    class StaticLaunch
      # The cache's directory.
      @directory: String

      # The project's root, where the process runs.
      @root: String

      # `Process`, or a stand-in in a test.
      @process: singleton(::Process)

      # Builds the launch.
      #
      # - `directory`: String, the cache's directory.
      # - `root`: String, the project's root.
      # - `process`: `Process`, or a stand-in in a test.
      def initialize: (String directory, String root, ?singleton(::Process) process) -> void

      # Makes the run's folder, starts its process, and returns the watch
      # over it, with the run's time limit starting now.
      #
      # - `run`: Stryker::MutantRun, the run.
      # - `runner`: String, the test runner's name.
      def call: (MutantRun run, String runner) -> FreshWatch

      private

      # Spawns the process of `fresh`, and returns its process ID.
      def spawn: (FreshRun fresh, String runner) -> Integer
    end
  end
end
