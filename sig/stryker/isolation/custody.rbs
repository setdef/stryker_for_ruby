module Stryker
  module Isolation
    # What a launch has started, from the moment its process starts until a
    # watch holds it. When the launch fails in that time, or a signal ends
    # it, the custody ends the process, and then removes what the launch
    # made, such as the run's folder, which the process writes into.
    #
    # ## Examples
    #
    # ```ruby
    # watch = Stryker::Isolation::Deferred.signals do
    #   Stryker::Isolation::Custody.new(fresh).around do |custody|
    #     child = custody.child(Process.spawn("sleep", "1"))
    #     Stryker::Isolation::FreshWatch.new(fresh, child, Stryker::Isolation::Timer.new(5000))
    #   end
    # end
    # ```
    class Custody
      # What a launch made, and a custody removes: a run's folder, or the
      # fork parent's folder and pipes.
      interface _Made
        # Deletes what the launch made.
        def remove: () -> void
      end

      # What the launch made, which the custody removes when the launch
      # fails.
      @made: _Made

      # `Process`, or a stand-in in a test.
      @process: singleton(::Process)

      # The ID of the process that the launch started, once it has.
      @pid: Integer?

      # The handle over that process, once the launch made one.
      @child: Child?

      # Builds the custody of a launch that has started nothing.
      #
      # - `made`: what the launch made, which answers `remove` by deleting it:
      #   a `Stryker::Isolation::FreshRun`, say.
      # - `process`: `Process`, or a stand-in in a test.
      def initialize: (_Made made, ?singleton(::Process) process) -> void

      # Yields the custody, and returns what the block returns. Call it
      # inside `Stryker::Isolation::Deferred.signals`: the custody defers no
      # signal itself, so a signal that arrives in the block reaches it at
      # once, and only the caller's deferral makes the launch whole. When the
      # block raises, the process the custody holds is ended and what the
      # launch made removed, and the error reaches the caller unchanged.
      def around: [T] () { (Custody custody) -> T } -> T

      # Holds the process whose ID is `pid`, and returns the handle over it.
      #
      # - `pid`: Integer, the ID of the process that the launch started.
      def child: (Integer pid) -> Child

      private

      # Ends the process the custody holds, if any, and then removes what the
      # launch made.
      def abandon: () -> void

      # Ends the process the custody holds: through its handle once it has
      # one, and by its ID before.
      def end_process: () -> void
    end
  end
end
