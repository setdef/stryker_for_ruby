module Stryker
  module Isolation
    # The temporary folder of one fresh run, made with `Dir.mktmpdir`: it
    # holds the file that holds the process's run, the file the process writes
    # its messages to, and the files that its standard output is copied into
    # and its standard error goes to. No name that the project chose becomes part of a path.
    #
    # ## Examples
    #
    # ```ruby
    # folder = Stryker::Isolation::FreshFolder.made
    # folder.paths(run)
    # # => ["<folder>/run", "<folder>/results"]
    # folder.messages.ended?
    # # => false, before the process wrote anything
    # folder.remove
    # ```
    class FreshFolder
      # The folder's path.
      @path: String

      # The files of the process's standard output and standard error.
      @outputs: OutputFiles

      # Makes a new temporary folder, and returns it.
      def self.made: () -> FreshFolder

      # The folder at `path`, which exists.
      #
      # - `path`: String, the folder's path.
      def initialize: (String path) -> void

      # Writes `run` to the run's file, as JSON in binary mode, and returns
      # its path and the path of the results' file, for the process's
      # arguments.
      #
      # - `run`: the run, a Stryker::MutantRun or the dry run.
      def paths: (forked run) -> [String, String]

      # The options of `Process.spawn` for the process's standard streams:
      # standard input on the null device, standard output on `out`, and
      # standard error on a file in the folder.
      #
      # - `out`: IO, the write end of the pipe for standard output.
      def output_options: (IO out) -> Hash[Symbol, String | IO]

      # The path of the file in the folder that the process's standard output
      # is copied into.
      def output_path: () -> String

      # Whether the process has started a test: the results' file begins
      # with a whole line for a test that started. False before the process
      # opened the file.
      def started?: () -> bool

      # The messages in the results' file, up to the last whole line. A
      # process that ended before it opened the file has none.
      def messages: () -> Messages

      # The last lines of the process's standard error, or an empty String
      # when it wrote none.
      def errors: () -> String

      # Deletes the folder, if it is still there.
      def remove: () -> void

      private

      # The path of the results' file.
      def results_path: () -> String

      # What the process wrote to the results' file.
      def results_text: () -> String
    end
  end
end
