module Stryker
  module Isolation
    # The parent that forks, and the runs that the orchestrator gives it,
    # from when it gives each one until the parent says how its child ended.
    # It keeps at most the window's number of runs in the parent at once,
    # and sends each line that the parent writes about a run to that run's
    # flight.
    #
    # ## Examples
    #
    # ```ruby
    # flights = Stryker::Isolation::Flights.new(parent, config.concurrency)
    # flights.run([Stryker::Isolation::Flight.new(run) { |messages, ending| puts(ending.exit_status) }])
    # flights.stop
    # ```
    class Flights
      # The text of the error for a parent that ended while runs were in
      # flight.
      ENDED: String

      # The parent, which has loaded the tests.
      @parent: ParentProcess

      # How many runs may be in the parent at once.
      @window: Integer

      # Each flight, by its run's relay key.
      @flights: Hash[Hash[String, JsonValue::json_value], Flight]

      # Builds the set, with no run in flight.
      #
      # - `parent`: Stryker::Isolation::ParentProcess, the parent, which has
      #   loaded the tests.
      # - `window`: Integer, how many runs may be in the parent at once.
      def initialize: (ParentProcess parent, Integer window) -> void

      # Gives the parent the run of every flight of `flights`, at most the
      # window's number at once, and lands each flight as the parent says
      # how its child ended. Raises `Stryker::Isolation::Error` when the
      # parent ends, or writes a line about a run that isn't in flight. A
      # flight leaves the set before it lands, so a landing that raises
      # leaves no ended child for `stop` to kill.
      #
      # - `flights`: Array of Stryker::Isolation::Flight, one for each run.
      def run: (Array[Flight] flights) -> void

      # Stops the parent, as `Stryker::Isolation::ParentProcess#stop` does,
      # then kills the group of each child that the parent said it forked
      # and never said ended, and empties the set. It kills those groups
      # and empties the set when stopping the parent raises, too, and the
      # error reaches the caller unchanged.
      def stop: () -> nil

      private

      # Adds `flight`, and gives the parent its run.
      def dispatch: (Flight flight) -> nil

      # Reads the parent's next line, hands it to its run's flight, and lands
      # the flight when the line says how its child ended.
      def receive: () -> nil

      # Takes `flight`, whose relay key is `key`, out of the set, and lands
      # it with `ending`.
      def land: (Hash[String, JsonValue::json_value] key, Flight flight, Ending ending) -> nil

      # The flight of the run whose relay key is `key`. Raises
      # `Stryker::Isolation::Error`, naming the parent's line `object`, when
      # no such run is in flight.
      def flight: (Hash[String, JsonValue::json_value] key, Hash[String, JsonValue::json_value] object) -> Flight
    end
  end
end
