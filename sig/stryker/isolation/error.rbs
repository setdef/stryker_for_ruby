module Stryker
  module Isolation
    # Raised when an isolation adapter can't run the runs it was given: the
    # parent that forks ended before it loaded the tests or while runs were
    # in flight, it wrote a line that is no message, or the adapter wasn't
    # started. The message says what happened, and what the parent said
    # when it said anything.
    #
    # A run whose own process crashes, exits, or runs past its time isn't
    # one: that run has a result, with the status `RuntimeError` or
    # `Timeout`.
    class Error < StandardError
    end
  end
end
