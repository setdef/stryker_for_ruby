module Stryker
  module Testing
    module IsolationContract
      # The contract's tests of each status a run's process can give.
      module Statuses : ::Minitest::Test, _IsolationHost
        include Sample

        # The mutant IDs of the runs that go two at a time.
        MANY: Array[Integer]

        # A run whose test fails is `Killed`, by that test, with its failure
        # as the reason.
        def test_a_failed_test_kills_the_mutant: () -> void

        # A run whose tests all pass is `Survived`, with every test
        # counted.
        def test_a_run_whose_tests_all_pass_survives: () -> void

        # A result lists the tests that its run lists as covering its
        # mutant, which can be fewer than the tests the run ran.
        def test_a_result_is_covered_by_the_tests_its_run_lists_as_covering_it: () -> void

        # A run stops at its first failed test, and runs none after it.
        def test_a_run_stops_at_its_first_failed_test: () -> void

        # A run past its time limit is `Timeout`, with the tests that
        # finished before it counted.
        def test_a_run_past_its_time_limit_times_out: () -> void

        # Each run gives one result, with its mutant and how long it took,
        # with two runs at a time.
        def test_each_run_gives_one_result_with_its_mutant_and_time: () -> void
      end
    end
  end
end
