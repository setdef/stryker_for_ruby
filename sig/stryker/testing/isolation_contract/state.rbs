module Stryker
  module Testing
    module IsolationContract
      # The contract's test that each run starts clean, as
      # [ADR 0002](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/contributors/decisions/0002-every-mutant-runs-in-a-clean-process.md)
      # records.
      module State : ::Minitest::Test, _IsolationHost
        include Sample

        # A run that changes a global, a constant's contents, a class
        # variable, and an environment variable, and defines a constant,
        # leaves each run after it unchanged. The run that changes the state
        # ends before any run that checks starts.
        def test_a_run_that_changes_state_leaves_the_next_run_unchanged: () -> void

        private

        # Runs the sample's run that changes state alone, then the runs
        # that check it together, and returns each result by its mutant's ID.
        def changed_then_checked: (SampleProject sample) -> Hash[Integer, MutantResult]
      end
    end
  end
end
