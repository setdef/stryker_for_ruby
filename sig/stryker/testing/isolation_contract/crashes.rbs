module Stryker
  module Testing
    module IsolationContract
      # The contract's tests of a run whose process ends early.
      module Crashes : ::Minitest::Test, _IsolationHost
        include Sample

        # A process that calls `exit!(1)` once a failed test's result is
        # written still kills the mutant.
        def test_a_process_that_exits_after_a_failed_test_still_kills_the_mutant: () -> void

        # A process that sends itself KILL once a failed test's result is
        # written still kills the mutant.
        def test_a_process_that_a_signal_ends_after_a_failed_test_still_kills_the_mutant: () -> void

        # A process that calls `exit!(3)` in a test is a `RuntimeError` whose
        # reason gives the exit status.
        def test_a_process_that_exits_before_any_result_is_a_runtime_error: () -> void

        # A `RuntimeError`'s reason ends with the end of what the run's
        # process wrote to its standard error.
        def test_a_runtime_errors_reason_ends_with_the_end_of_standard_error: () -> void

        # A test that calls `exit` is a `RuntimeError` whose reason
        # gives SystemExit.
        def test_a_test_that_calls_exit_is_a_runtime_error: () -> void

        private

        # Asserts that a run of the sample test `name` is `Killed` by it.
        def assert_killed_by: (Symbol name) -> void

        # Asserts that a run of the sample tests `names` is a
        # `RuntimeError`, with `completed` tests finished and `reason` in
        # its reason.
        def assert_runtime_error: (Array[Symbol] names, Integer completed, String reason) -> void
      end
    end
  end
end
