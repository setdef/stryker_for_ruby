module Stryker
  module Testing
    module IsolationContract
      # The adapter under test, started for one sample project: it runs the
      # project's runs, and stops the adapter afterwards.
      #
      # ## Examples
      #
      # ```ruby
      # session = Stryker::Testing::IsolationContract::Session.new(self, sample, 2)
      # session.results(sample.runs([1, 10], :passes))
      # # => {1 => #<data Stryker::MutantResult ...>, 10 => #<data Stryker::MutantResult ...>}
      # ```
      class Session
        # The sample project.
        @sample: SampleProject

        # The started adapter.
        @isolation: _Isolation

        # Builds the adapter that `host` makes for `sample`, and starts it.
        #
        # - `host`: Stryker::Testing::_IsolationHost, the contract's test.
        # - `sample`: Stryker::Testing::IsolationContract::SampleProject.
        # - `concurrency`: Integer, how many runs go at once.
        def initialize: (_IsolationHost host, SampleProject sample, Integer concurrency) -> void

        # Runs each batch of runs in turn, the next after the one before has
        # ended, stops the adapter, and returns each result by its mutant's
        # ID.
        def results: (*Array[MutantRun] batches) -> Hash[Integer, MutantResult]

        # Runs the sample project's hanging runs, raises from the block at
        # the first result, and returns the recorded processes still
        # running once `run_all` raised and before the adapter stops. When
        # `run_all` doesn't raise, it returns what `run_all` returned, which
        # is no list of processes, so the contract's test fails.
        def running_after_a_raise: () -> top

        private

        # Runs `runs` and returns their results in the order they end.
        def collected: (Array[MutantRun] runs) -> Array[MutantResult]
      end
    end
  end
end
