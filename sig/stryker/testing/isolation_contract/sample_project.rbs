module Stryker
  module Testing
    module IsolationContract
      # The sample Minitest project of one contract test, in a new folder,
      # and the cache of its instrumented library, in another: the library
      # of `Stryker::Testing::IsolationContract::SampleLibrary`, and the
      # helper and tests of `Stryker::Testing::IsolationContract::SampleSuite`.
      #
      # ## Examples
      #
      # ```ruby
      # Stryker::Testing::IsolationContract::SampleProject.open(static: false) do |sample|
      #   sample.run(Stryker::Testing::IsolationContract::SampleLibrary::KILLING, :value)
      # end
      # # => #<data Stryker::MutantRun mutant: ..., test_ids: ["IsolationSampleTest#test_value"], ...>
      # ```
      class SampleProject
        # An ID that no switch in the instrumented library holds, so that a
        # run of it leaves the code as it was: 2.
        HARMLESS: Integer

        # The time limit of a run that sets none: 30 seconds.
        TIME_LIMIT_MS: Integer

        # The project's root.
        attr_reader root: String

        # The cache's directory.
        attr_reader cache: String

        # Whether the project's runs are static mutants' runs.
        @static: bool

        # Writes a new project, yields it, and removes it, and returns what
        # the block returns.
        #
        # - `static`: bool, whether the project's runs are static mutants'
        #   runs.
        def self.open: [T] (static: bool) { (SampleProject sample) -> T } -> T

        # The ID of the sample test `test_<name>`, such as
        # `"IsolationSampleTest#test_value"`.
        #
        # - `name`: Symbol, the test's name without its `test_` prefix.
        def self.id: (Symbol name) -> String

        # A mutant of the sample library with `id`.
        #
        # - `id`: Integer, the mutant's ID.
        def self.mutant: (Integer id) -> Mutant

        # Writes `source` to `path`, in binary mode, and makes its folder.
        #
        # - `path`: String, the file's path.
        # - `source`: String, what the file holds.
        def self.write: (String path, String source) -> void

        # Writes the project and its cache to two new folders.
        #
        # - `static`: bool, whether the project's runs are static mutants'
        #   runs.
        def initialize: (bool static) -> void

        # A run of mutant `mutant_id` with the sample tests `names`.
        #
        # - `mutant_id`: Integer, the mutant's ID.
        # - `names`: Symbol, each test's name without its `test_` prefix.
        # - `timeout_ms`: Integer, the time limit, `TIME_LIMIT_MS` by
        #   default.
        def run: (Integer mutant_id, *Symbol names, ?timeout_ms: Integer) -> MutantRun

        # A run of each mutant in `ids` with the sample test `name`.
        #
        # - `ids`: Array of Integer, the mutants' IDs.
        # - `name`: Symbol, the test's name without its `test_` prefix.
        def runs: (Array[Integer] ids, Symbol name) -> Array[MutantRun]

        # A run that hangs, and one that fails once the first has recorded
        # its process.
        def hanging_runs: () -> Array[MutantRun]

        # The run of `SampleSuite::CHANGER`, which changes the process's
        # state, and then a run of each of `SampleSuite::CHECKS`.
        def state_runs: () -> Array[MutantRun]

        # Removes both folders.
        def remove: () -> void

        private

        # Writes the project's files and the cache.
        def write: () -> void

        # The project's files by their paths, with the library at `library`.
        def files: (String library) -> Hash[String, String]
      end
    end
  end
end
