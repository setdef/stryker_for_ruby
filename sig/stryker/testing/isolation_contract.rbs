module Stryker
  module Testing
    # The tests that every adapter of the `Stryker::_Isolation` port
    # passes. Include it in a Minitest test class, and define the two
    # methods of `Stryker::Testing::_IsolationHost` there: one that builds
    # the adapter for a project and a cache, and one that says whether the
    # adapter runs static mutants.
    #
    # Each test writes a sample Minitest project to a new folder, with the
    # cache of its one instrumented file, and runs real mutant runs of it
    # through the adapter, in real processes. The project's test helper
    # requires `minitest`, so the test process's environment has to let a
    # new Ruby process load Minitest, as `bundle exec` does.
    #
    # The contract checks that a failed test kills the mutant, that a run
    # whose tests pass survives, that a run stops at its first failure, and
    # that a run past its time limit times out. It checks that a process
    # that crashes after a test failed still kills the mutant, whether it
    # exits or a signal ends it, and that a process that exits before any
    # result is a `RuntimeError`. It checks that a run which changes a
    # global, a constant's contents, a class variable, or an environment
    # variable, or which defines a constant, leaves the next run unchanged.
    # And it checks that every process the adapter started has ended when
    # `stop` returns, or when the block given to `run_all` raises.
    #
    # Its tests come in four modules, which it includes:
    # `Stryker::Testing::IsolationContract::Statuses`, `Crashes`, `State`,
    # and `Cleanup`.
    #
    # ## Examples
    #
    # ```ruby
    # require "stryker/testing"
    #
    # class MyIsolationContractTest < Minitest::Test
    #   include Stryker::Testing::IsolationContract
    #
    #   def isolation_under_test(cache, root)
    #     MyIsolation.new(cache, root)
    #   end
    #
    #   def runs_static_mutants?
    #     false
    #   end
    # end
    # ```
    #
    # > [!WARNING]
    # > Name neither method with a `test_` prefix. Minitest runs every
    # > public method whose name starts with `test_` as a test.
    module IsolationContract : ::Minitest::Test, _IsolationHost
      include Statuses

      include Crashes

      include State

      include Cleanup
    end
  end
end
