module Stryker
  class Configure
    # One option as the user gave it, before any check: the option's name,
    # its value as the file or the command line holds it, and where it came
    # from.
    class Setting < Data
      # The option's name, with a dot between a nested option and its
      # parents: `thresholds.break`.
      attr_reader name: String

      # The value as read, which may have the wrong type.
      attr_reader value: Object?

      # Where the value came from.
      attr_reader origin: Origin

      # The keys that the file wrote to reach the value, outermost first:
      # `["thresholds", "break"]` for a `break` inside `thresholds`, and
      # `["thresholds.break"]` for the dotted key. For a flag it is the
      # option's name alone.
      attr_reader keys: Array[String]

      # Returns the setting's name in quotes, followed by where it came from,
      # as `Origin#mention` writes it.
      def mention: () -> String

      # Returns an option's name as this setting's origin spells it.
      def spell: (String option) -> String

      # Returns whether the value has the type that the option takes, as
      # `Types::KINDS` has it. A setting whose name is no option is valid,
      # because its type accepts every value.
      def valid?: () -> bool

      # Returns the keys as the user wrote them, innermost first, each in
      # quotes: `"break" inside "thresholds"`, or `"thresholds.break"`.
      def written: () -> String

      # Builds a setting. Without `keys`, the setting was written as one key,
      # its name.
      def initialize: (name: String, value: Object?, origin: Origin, ?keys: Array[String]) -> void

      def self.new: (name: String, value: Object?, origin: Origin, ?keys: Array[String]) -> instance
                  | (String name, Object? value, Origin origin, ?Array[String] keys) -> instance
    end
  end
end
