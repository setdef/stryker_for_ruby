module Stryker
  class Configure
    module Checks
      # Checks that no pattern of `minitest.testFiles` holds bytes that
      # aren't UTF-8, whatever encoding the string has, because the orchestrator
      # writes the test runner's options as JSON for a project process, and
      # JSON can't carry them. It applies only to the options whose strings
      # cross that way, which are in `OPTIONS`: `mutate` stays in the
      # orchestrator, which reads files with any name. It runs before
      # `OutsidePatterns`. The line names the pattern.
      class NotUtf8InProcessOptions
        # The names of the options whose strings cross to a project process as
        # JSON: `minitest.testFiles`.
        OPTIONS: Array[String]

        @setting: Setting

        # Builds the check.
        def initialize: (Setting setting) -> void

        # Returns one line for each pattern that isn't UTF-8, or none.
        def to_a: () -> Array[String]
      end
    end
  end
end
