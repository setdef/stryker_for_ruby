module Stryker
  class Configure
    # The type that each option takes, as a check and as a phrase for an
    # error message.
    module Types
      # One type: what to call it in a message, the check for a value, and how
      # to turn a checked value into the one that `Stryker::Config` holds.
      class Kind < Data
        # The type as a phrase that follows "takes", such as `a string`.
        attr_reader description: String

        # The check: true for a value of the type.
        attr_reader test: ^(Object? value) -> bool

        # The conversion of a checked value: for a kind that holds the value
        # as it was given, the identity.
        attr_reader conversion: ^(Object? value) -> Object?

        # Builds a kind. Without `conversion`, the kind holds a value as it
        # was given.
        def initialize: (description: String, test: ^(Object? value) -> bool, ?conversion: ^(Object? value) -> Object?) -> void

        def self.new: (description: String, test: ^(Object? value) -> bool, ?conversion: ^(Object? value) -> Object?) -> instance
                    | (String description, ^(Object? value) -> bool test, ?^(Object? value) -> Object? conversion) -> instance

        # Returns whether `value` has the type.
        def accepts?: (Object? value) -> bool

        # Returns `value`, which the type accepts, as `Stryker::Config` holds
        # it.
        def convert: (Object? value) -> Object?
      end

      # The conversion of a kind that holds a value as it was given.
      AS_GIVEN: ^(Object? value) -> Object?

      # The names of the options whose value is a list of file patterns, which
      # the checks of patterns read: `mutate` and `minitest.testFiles`.
      PATTERN_LISTS: Array[String]

      # The form of a percentage for `concurrency`: 0 to 100, with a percent
      # sign.
      PERCENT: Regexp

      # The kind of each option, by the option's name. A name that is no
      # option has a kind that accepts every value.
      KINDS: Hash[String, Kind]

      # Returns the type of an array of Strings. `what` names the strings
      # in a message: `file patterns`.
      def self.list_of: (String what) -> Kind

      # Returns `value` as an Array of Strings. The check has already made
      # sure that it is one, and the conversion tells Steep the type.
      def self.strings: (Object? value) -> Array[String]

      # Returns the type of a finite number in a range, a whole number or a
      # fraction. A whole number too big to be a Float isn't finite as a
      # Float, so it isn't in the type.
      # The value is converted with `conversion`, which holds it as given when
      # it is left out.
      def self.number: (String description, Range[Numeric?] range, ?^(Object? value) -> Object? conversion) -> Kind
    end
  end
end
