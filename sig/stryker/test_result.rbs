module Stryker
  # What happened when one test ran: whether it passed, failed, or was
  # skipped, the failure's message, and how long it took. The test runner
  # adapter makes one for each test it runs, and a project process writes it
  # to a pipe as soon as the test finishes, so a failure reaches the
  # orchestrator even when the process ends before it writes anything else
  # ([#20](https://github.com/setdef/stryker_for_ruby/issues/20)).
  #
  # A test result is a value: two results with equal members are equal. It
  # refuses a `status` that isn't in `Stryker::TestResult::STATUSES` with
  # ArgumentError, and checks no other member. It converts to and from JSON,
  # as `Stryker::JsonValue` says: `to_json` replaces each byte of
  # `failure_message` that isn't valid UTF-8 with U+FFFD, so a failure that
  # has such a message still reaches the orchestrator.
  #
  # ## Examples
  #
  # A failed test:
  #
  # ```ruby
  # test = Stryker::Test.new(id: "Shop::DiscountTest#test_rate", name: "test_rate", file: nil, location: nil)
  # result = Stryker::TestResult.new(test:, status: "failed", failure_message: "Expected 90, got 100", duration_ms: 0.4)
  # Stryker::TestResult.from_json(result.to_json) == result
  # # => true
  # ```
  #
  # A status that isn't one of the three:
  #
  # ```ruby
  # Stryker::TestResult.new(test:, status: "failure", failure_message: nil, duration_ms: 0.4)
  # # => ArgumentError: unknown test status "failure", expected one of passed, failed, skipped
  # ```
  class TestResult < Data
    include JsonValue
    extend JsonValue::Reading[TestResult]

    # The statuses a result can have.
    STATUSES: Array[String]

    # The test that ran.
    attr_reader test: Test

    # `"passed"`, `"failed"`, or `"skipped"`.
    attr_reader status: String

    # The failure's message, or nil for a test that didn't fail. The result
    # doesn't check the message against the status.
    attr_reader failure_message: String?

    # How long the test took, in milliseconds, with a fraction for a test
    # that takes less than one.
    attr_reader duration_ms: Float

    # Builds the result. Raises ArgumentError when `status` isn't in
    # `STATUSES`.
    #
    # - `test`: Stryker::Test, the test that ran.
    # - `status`: String, `"passed"`, `"failed"`, or `"skipped"`.
    # - `failure_message`: String or nil, the failure's message.
    # - `duration_ms`: Float, how long the test took, in milliseconds.
    def self.new: (test: Test, status: String, failure_message: String?, duration_ms: Float) -> instance
                | (Test test, String status, String? failure_message, Float duration_ms) -> instance

    # The readers of the members of a test result that hold another value, as
    # `Stryker::JsonValue::Reading#readers` describes: `test` reads a Hash into a `Stryker::Test`.
    def self.readers: () -> Hash[Symbol, Proc]

    # Builds the result, and raises ArgumentError when `status` isn't in
    # `STATUSES`.
    def initialize: (status: String, **Object) -> void
  end
end
