module Stryker
  class Instrumenter
    # Puts code in place of a node of a parsed file, for
    # `Stryker::Instrumenter::OneLine` to parse a joined line where the
    # node stands.
    module InPlace
      # The file's source with `text` in place of `node`, and
      # without the bodies of the heredocs whose openers `node` holds and
      # that lie below it. `text` holds no opener to read those bodies, which
      # would stay in the file as code.
      #
      # - `node`: Prism::node, a node of `parsed`.
      # - `parsed`: Prism::ParseResult, what Prism makes of the file.
      # - `text`: String, the code that takes the node's place, with no
      #   heredoc opener.
      def self.of: (Prism::node node, Prism::ParseResult parsed, String text) -> String
    end
  end
end
