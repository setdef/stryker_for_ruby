module Stryker
  class Instrumenter
    # Finds the node that a mutant's switch wraps: the innermost node whose
    # source range holds the mutant's whole edit, and that can hold a switch
    # where it stands. When the site, the innermost node around the edit,
    # can't hold one, the switch moves out to the nearest enclosing node that
    # can. `Stryker::Instrumenter::Lineage` decides which nodes can.
    #
    # An edit inside a heredoc's body lies outside the range of the heredoc's
    # opener, and of every node around the opener. A node holds such an edit
    # when its range holds the opener, so the switch goes on the heredoc
    # itself, or on a node inside its interpolation that holds the edit.
    #
    # ## Examples
    #
    # ```ruby
    # source = "s = <<~EOS\n  hello\nEOS\n"
    # tree = Prism.parse(source).value
    # heredocs = Stryker::Instrumenter::Heredoc.in(tree)
    # bodies = heredocs.map { |heredoc| [heredoc, Stryker::Instrumenter::HeredocBody.of(heredoc, heredocs)] }
    # mutant = Stryker::Mutant.new(id: 1, file: "a.rb", mutator_name: "StringLiteral",
    #                              start_offset: 13, end_offset: 18, replacement: "hellx")
    # Stryker::Instrumenter::Placement.node_for(tree, mutant, bodies).slice
    # # => "<<~EOS"
    # ```
    class Placement
      # The node whose source range the switch for `mutant` wraps, in `tree`,
      # or nil when no node around the mutant's site can hold a switch.
      #
      # - `tree`: Prism::ProgramNode, the parsed file.
      # - `mutant`: Stryker::Mutant, an edit on that file.
      # - `bodies`: Array of pairs, each a heredoc in the file and the
      #   Stryker::Instrumenter::Span of its body, as
      #   `Stryker::Instrumenter::HeredocBody.of` gives it.
      def self.node_for: (Prism::ProgramNode tree, Mutant mutant, Array[[Heredoc::node, Span]] bodies) -> Prism::node?

      # Prepares to search for `mutant`'s edit.
      #
      # - `mutant`: Stryker::Mutant, the edit.
      # - `bodies`: Array of pairs, each a heredoc in the file and the
      #   Stryker::Instrumenter::Span of its body.
      def initialize: (Mutant mutant, Array[[Heredoc::node, Span]] bodies) -> void

      # The innermost node in `tree` that holds the edit and can hold a
      # switch, or nil when there is none.
      #
      # - `tree`: Prism::node, the node to search from, usually the parsed
      #   file.
      def holder_in: (Prism::node tree) -> Prism::node?

      private

      @mutant: Mutant
      @openers: Array[Span]

      def holder_below: (Lineage lineage, Prism::node? holder) -> Prism::node?

      def child_covering: (Prism::node node) -> Prism::node?

      def covers?: (Prism::node node) -> bool
    end
  end
end
