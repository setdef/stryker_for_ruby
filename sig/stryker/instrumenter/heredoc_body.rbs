module Stryker
  class Instrumenter
    # Finds where a heredoc's body lies in a file. A heredoc's body starts on
    # the line after its opener, outside the location of the opener and of
    # every node around it.
    module HeredocBody
      # The stretch that holds `node`'s body and its closing line. It starts
      # on the line after the opener, or after the closing line of a heredoc
      # whose opener comes earlier on that line, and ends after the closing
      # line's line break. For a heredoc with no body it is the closing line
      # alone. Raises `ArgumentError` when `node` is a string that isn't a
      # heredoc.
      #
      # - `node`: Stryker::Instrumenter::Heredoc::node, a heredoc.
      # - `heredocs`: Array of Stryker::Instrumenter::Heredoc::node, every
      #   heredoc in the file.
      def self.of: (Heredoc::node node, Array[Heredoc::node] heredocs) -> Span

      def self.start_offset: (Heredoc::node node, Array[Heredoc::node] heredocs) -> Integer

      def self.closings_before: (Prism::Location opener, Array[Heredoc::node] heredocs) -> Array[Integer]

      def self.opens_before?: (Prism::Location other, Prism::Location opener) -> bool

      def self.closing: (Heredoc::node node) -> Prism::Location
    end
  end
end
