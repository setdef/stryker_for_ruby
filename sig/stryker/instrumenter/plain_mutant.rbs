module Stryker
  class Instrumenter
    # The plain mutant: the original file with the source of the node that a
    # mutant's switch wraps replaced by the mutant's text in parentheses.
    # That is exactly what the switch's branch runs, so with the mutant
    # active, the instrumented file has to run as this file runs. When the
    # plain mutant doesn't parse, the mutant isn't valid Ruby.
    #
    # The text is the node's source with the mutant's edit made. The plain
    # mutant also leaves out the body of every heredoc whose opener the edit
    # replaces, unless the replacement holds `<<`. An opener that the edit
    # replaced would leave its body in the file as code. The switch's
    # original branch keeps the heredoc, and its body, in the instrumented
    # file.
    #
    # The parentheses keep the text's meaning apart from the code around
    # it: in `a + b * c`, the mutant that makes `b * c` into `b - c` has the
    # plain mutant `a + (b - c)`, as the switch runs it, and not
    # `a + b - c`, which adds first.
    #
    # ## Examples
    #
    # The text `a) + (b` doesn't parse alone, but its plain mutant,
    # `(a) + (b)`, does:
    #
    # ```ruby
    # source = "total = a + b\n"
    # mutant = Stryker::Mutant.new(id: 1, file: "a.rb", mutator_name: "Case",
    #                              start_offset: 8, end_offset: 13, replacement: "a) + (b")
    # node = Prism.parse(source).value.statements.body.first.value
    # plain = Stryker::Instrumenter::Outcomes.new(source, []).plain_mutant(mutant, node)
    # [plain.result.source.source, plain.result.success?]
    # # => ["total = (a) + (b)\n", true]
    # ```
    class PlainMutant < Data
      # The mutant.
      %a{pure} attr_reader mutant: Mutant

      # Where the mutant's text lies in the plain mutant, inside the
      # parentheses.
      %a{pure} attr_reader span: Span

      # What Prism makes of the plain mutant.
      %a{pure} attr_reader result: Prism::ParseResult

      # Builds the plain mutant from its parts.
      #
      # - `mutant`: Stryker::Mutant, the mutant.
      # - `span`: Stryker::Instrumenter::Span, where its text lies.
      # - `result`: Prism::ParseResult, what Prism makes of the file.
      def self.new: (mutant: Mutant, span: Span, result: Prism::ParseResult) -> instance
                  | (Mutant mutant, Span span, Prism::ParseResult result) -> instance

      # `source` without `bodies`, as binary.
      #
      # - `source`: String, a file's source.
      # - `bodies`: Array of Stryker::Instrumenter::Span, stretches of
      #   `source` that don't overlap, in the order of the file.
      def self.without: (String source, Array[Span] bodies) -> String

      # `text` with the stretch at `span` in parentheses, as binary.
      #
      # - `text`: String, a file's source.
      # - `span`: Stryker::Instrumenter::Span, a stretch of `text`.
      def self.wrapped: (String text, Span span) -> String

      # How many bytes longer `mutant`'s edit, with `bodies` removed, makes
      # the range of the node at `location`, a node of the original file
      # that holds the edit: the bytes that the edit adds, less the bodies
      # that lie inside the node. An edit inside a heredoc's body that lies
      # after the node's range adds none.
      #
      # - `mutant`: Stryker::Mutant, the mutant.
      # - `bodies`: Array of Stryker::Instrumenter::Span, the heredoc bodies
      #   that the plain mutant leaves out, in the order of the file.
      # - `location`: Prism::Location, the node's range.
      def self.growth: (Mutant mutant, Array[Span] bodies, Prism::Location location) -> Integer

      private def self.edit_growth: (Mutant mutant, Prism::Location location) -> Integer
    end
  end
end
