module Stryker
  class Instrumenter
    # Tells whether a mutant's text closes everything it opens, from its
    # tokens as Prism lexes them. Text that leaves a bracket, a keyword pair,
    # a string, a regexp, or a heredoc open, or that closes one it didn't
    # open, would read the code around it as part of itself, so another
    # mutant's text nearby could balance it.
    #
    # The text is lexed alone, with nothing around it, so text that only
    # lexes the same way in its file, such as a node that names a local
    # variable before `/`, can come out either way.
    #
    # ## Examples
    #
    # ```ruby
    # Stryker::Instrumenter::TokenBalance.balanced?("f(a) + [b]")
    # # => true
    # Stryker::Instrumenter::TokenBalance.balanced?("a) + (b")
    # # => false
    # Stryker::Instrumenter::TokenBalance.balanced?("\"a(b\"")
    # # => true
    # ```
    module TokenBalance
      # Whether `text` closes, in the order it opened them, every
      # parenthesis, bracket, and brace, every `begin`, `case`, `class`,
      # `def`, `do`, `for`, `if`, `module`, `unless`, `until`, and `while`
      # that needs an `end`, every string, symbol, regexp, interpolation, and
      # `=begin`, and every heredoc opener, with its terminator.
      #
      # An endless method, such as `def f = 1`, has no `end`, so it is false
      # for text that holds one. It is true for empty text. It doesn't tell
      # whether the text parses: `a +` balances, and so does `return` where
      # Ruby allows no `return`.
      #
      # - `text`: String, Ruby code, such as a mutant's text.
      def self.balanced?: (String text) -> bool

      private def self.step: (Array[Symbol] stack, Prism::Token token) -> boolish
    end
  end
end
