module Stryker
  class Instrumenter
    # Finds a node by its range in a parsed file, such as the node of a
    # mutant's text in the plain mutant, for a mutant whose text spans
    # several lines. Parsing the whole file, and not only the node's text,
    # keeps what the code around the node means, such as which names are
    # local variables.
    module MutatedNode
      # The node in `tree` whose range is `span`, the outermost one when
      # several have it, or nil when none does. A `ProgramNode` with that
      # range doesn't count, so the result is the statements it holds. When
      # `span` is a mutant's text that makes several statements, as when
      # `if c` becomes `if c then 5 end; if !c`, it is their
      # `StatementsNode`. Text that starts or ends with a line break has no
      # node.
      #
      # - `tree`: Prism::node, the node to search, usually a parsed file.
      # - `span`: Stryker::Instrumenter::Span, the range to find.
      def self.at: (Prism::node tree, Span span) -> Prism::node?

      CONTAINERS: Array[singleton(Prism::Node)]
    end
  end
end
