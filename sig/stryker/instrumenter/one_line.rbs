module Stryker
  class Instrumenter
    # Writes a node's code on one line, for a mutant whose text spans several.
    #
    # refract's converter and formatter write the node as valid Ruby that
    # means what the node means, without comments and with heredocs as string
    # literals. `Stryker::Instrumenter::LineJoin` then joins the lines. The
    # result counts only when Prism parses the node's file with the joined
    # line in place of the node, and finds there one node that refract
    # writes exactly as it wrote the node, so a join that changed the code's
    # meaning gives nil. Parsing the joined line in its file keeps what the
    # code around it allows, such as `yield` in a method, `break` and `next`
    # in a block, and `retry` in a `rescue`, which don't parse alone.
    #
    # ## Examples
    #
    # ```ruby
    # source = "def g\n  if ready\n    yield\n  end\nend\n"
    # parsed = Prism.parse(source)
    # node = parsed.value.statements.body.first.body.body.first
    # Stryker::Instrumenter::OneLine.of(node, parsed)
    # # => "if ready; yield; end"
    # ```
    module OneLine
      # The code of `node` on one line, as binary, or nil when it has none:
      # when a line break is inside a token, such as a regexp written over
      # several lines, or when the file with the joined line in place of
      # `node` doesn't parse back to the same code.
      #
      # - `node`: Prism::node, the node to write, a node of `parsed`.
      # - `parsed`: Prism::ParseResult, what Prism makes of the file that
      #   holds `node`.
      def self.of: (Prism::node node, Prism::ParseResult parsed) -> String?

      private def self.format: (Prism::node node) -> String

      private def self.same?: (Prism::node? found, String formatted) -> bool

      private def self.found_in_place: (Prism::node node, Prism::ParseResult parsed, String joined) -> Prism::node?
    end
  end
end
