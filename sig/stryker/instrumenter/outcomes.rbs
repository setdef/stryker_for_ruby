module Stryker
  class Instrumenter
    # Works out what the instrumenter does with each mutant of one file, from
    # the node that its switch wraps: whether the mutant is valid Ruby, and
    # the text of its branch. Both come from the mutant's plain mutant, as
    # `Stryker::Instrumenter::PlainMutant` defines it. Whether each plain
    # mutant parses is one question for the whole file, which
    # `Stryker::Instrumenter::ParsePool` answers, in this process or in a
    # pool of parse workers. Only a mutant whose text has to go on one line
    # with refract is parsed again, here, for the tree.
    #
    # ## Examples
    #
    # A void value doesn't parse in its parentheses, so the mutant isn't
    # valid:
    #
    # ```ruby
    # source = "x = f\n"
    # mutant = Stryker::Mutant.new(id: 1, file: "a.rb", mutator_name: "Case",
    #                              start_offset: 4, end_offset: 5, replacement: "return")
    # node = Prism.parse(source).value.statements.body.first.value
    # outcomes = Stryker::Instrumenter::Outcomes.new(source, [], Stryker::Instrumenter::ParsePool.new(1))
    # outcome = outcomes.all([mutant]) { node }.first
    # [outcome.valid, outcome.skip.reason]
    # # => [false, :does_not_parse]
    # ```
    class Outcomes
      # Prepares to work out the outcomes of the mutants of `source`.
      #
      # - `source`: String, the file's source.
      # - `heredocs`: Array of Stryker::Instrumenter::Heredoc::node, every
      #   heredoc in the file.
      # - `pool`: Stryker::Instrumenter::ParsePool, which parses the plain
      #   mutants.
      def initialize: (String source, Array[Heredoc::node] heredocs, ParsePool pool) -> void

      # The outcome of each mutant, in the order given. A mutant with no
      # node to hold its switch has no plain mutant, so nothing parses, and
      # its outcome is neither valid nor has a text.
      #
      # - `mutants`: Array of Stryker::Mutant, the mutants of the file. A
      #   mutant is an edit inside the node that holds its switch, or inside
      #   the body of a heredoc whose opener that node holds.
      # - The block gives the node of the original file that a mutant's
      #   switch wraps, or nil when no node can hold it.
      def all: (Array[Mutant] mutants) { (Mutant mutant) -> Prism::node? } -> Array[Outcome]

      private

      @source: String
      @heredocs: Array[Heredoc::node]
      @pool: ParsePool

      def held_for: (Array[Mutant] mutants, Array[Prism::node?] nodes) -> Array[[Mutant, Prism::node?, PlainMutant?]]

      def plain_mutant: (Mutant mutant, Prism::node node) -> PlainMutant

      def of: ([Mutant, Prism::node?, PlainMutant?] held, Enumerator[bool, void] verdicts) -> Outcome
    end
  end
end
