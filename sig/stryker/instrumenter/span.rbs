module Stryker
  class Instrumenter
    # A stretch of a source file, given by byte offsets.
    class Span < Data
      # The offset of the first byte in the stretch.
      attr_reader start_offset: Integer

      # The offset of the byte just after the stretch.
      attr_reader end_offset: Integer

      # Builds the span.
      #
      # - `start_offset`: Integer, the offset of the first byte.
      # - `end_offset`: Integer, the offset of the byte just after the last.
      def self.new: (start_offset: Integer, end_offset: Integer) -> instance
                  | (Integer start_offset, Integer end_offset) -> instance

      # The stretch that starts where `span` does, and ends `growth` bytes
      # after it, or before it when `growth` is negative.
      #
      # - `span`: Stryker::_Span, the stretch to grow.
      # - `growth`: Integer, how many bytes to add at its end.
      def self.grown: (_Span span, Integer growth) -> Span

      # The stretch that `span` takes up.
      #
      # - `span`: Stryker::_Span, a stretch, such as a `Prism::Location`.
      def self.of: (_Span span) -> Span

      # How many bytes the stretch has.
      def length: () -> Integer

      # Whether `other` starts and ends where this span does.
      #
      # - `other`: Stryker::_Span, another stretch.
      def same?: (_Span other) -> bool

      # Whether this stretch lies inside `other`, or is `other`.
      #
      # - `other`: Stryker::_Span, another stretch.
      def within?: (_Span other) -> bool
    end
  end
end
