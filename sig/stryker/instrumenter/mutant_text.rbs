module Stryker
  class Instrumenter
    # Makes the text that a mutant's branch runs: the wrapped node's original
    # source with the mutant's edit applied, on one line.
    #
    # When that text is on one line and leaves no heredoc in it, it goes
    # into the branch as it is. Otherwise, the instrumenter applies the edit
    # to the whole file, as `Stryker::Instrumenter::PlainMutant` does, and
    # puts the node at the edited range of the plain mutant, which
    # `Stryker::Instrumenter::MutatedNode` finds, on
    # one line with `Stryker::Instrumenter::OneLine`. A
    # heredoc left in the text would read its body from the lines below the
    # switch, which the original branch's heredoc reads, so such a text takes
    # the second path too: refract writes the heredoc as a string literal. So
    # does the text of a mutant whose edit lies inside a heredoc's body, whose
    # switch wraps the heredoc's opener.
    class MutantText
      # The text of `mutant`'s branch in the switch that wraps `node`, as
      # binary, or nil when the text has no form on one line. The text has
      # none when refract's formatting of it doesn't join onto one line, and
      # when the plain mutant has no one node at the edited range.
      #
      # - `source`: String, the file's source.
      # - `plain`: Stryker::Instrumenter::PlainMutant, the plain mutant, which
      #   holds the mutant that is an edit inside `node`.
      # - `node`: Prism::node, the node the switch wraps.
      def self.of: (String source, PlainMutant plain, Prism::node node) -> String?

      # Prepares to make the text of `mutant`'s branch.
      #
      # - `source`: String, the file's source.
      # - `plain`: Stryker::Instrumenter::PlainMutant, the plain mutant, which
      #   holds the mutant that is an edit inside `node`.
      # - `node`: Prism::node, the node the switch wraps.
      def initialize: (String source, PlainMutant plain, Prism::node node) -> void

      # The text, as `Stryker::Instrumenter::MutantText.of` gives it.
      def text: () -> String?

      private

      @source: String
      @plain: PlainMutant
      @mutant: Mutant
      @node: Prism::node

      def on_one_line?: (String edited) -> bool

      def heredoc_kept?: () -> bool

      def edited_in_place: () -> String?

      def formatted: () -> String?
    end
  end
end
