module Stryker
  class Instrumenter
    # Raised when the instrumenter can't make valid Ruby: when the file's
    # source doesn't parse, or when every plain mutant parses and the
    # instrumented source doesn't. A mutant whose plain mutant doesn't
    # parse, or that makes no one node in its parentheses, raises neither:
    # it gets no switch. An instrumented source that doesn't parse
    # means that a switch can't hold a mutant that is valid Ruby, which is a
    # fault in the instrumenter, or in the mutator that made the mutant. It
    # is also raised when the installed Prism doesn't know the syntax of the
    # running Ruby. The message gives each line, or both versions.
    class Error < StandardError
      # The error for a Ruby whose syntax the installed Prism doesn't know,
      # with a message that names both versions.
      #
      # - `ruby_version`: String, the Ruby's version.
      def self.unknown_syntax: (String ruby_version) -> Error

      # The error for source that doesn't parse, with a message that gives
      # each of Prism's `errors` and its line.
      #
      # - `errors`: Array of Prism::ParseError, what Prism found.
      # - `subject`: String, what didn't parse, such as `"source"`.
      def self.unparsable: (Array[Prism::ParseError] errors, String subject) -> Error

      # The error for a parse worker that ended, or answered with anything but
      # the verdict, with a message that gives the ID and file of the mutant
      # whose plain mutant it was parsing, and the last lines it wrote to its
      # standard error.
      #
      # - `mutant`: Stryker::Mutant, the mutant whose plain mutant the worker
      #   was parsing.
      # - `reply`: String, the line the worker wrote, or nil when it ended.
      # - `errors`: String, the last lines that the worker wrote to its
      #   standard error, or an empty string.
      def self.parse_worker: (Mutant mutant, String? reply, String errors) -> Error

      private def self.worker_failure: (String fault, String errors) -> Error

      private def self.placed: (Mutant mutant) -> String
    end
  end
end
