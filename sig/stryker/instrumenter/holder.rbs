module Stryker
  class Instrumenter
    # Decides whether a node can hold a switch where it stands, from the node,
    # its parent, and its grandparent. `Stryker::Instrumenter::Lineage` adds
    # what the nodes further up allow.
    #
    # Only a node of a kind that a row of the placement table in
    # [Mutant placement](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/design/mutant-placement.md#kinds-of-site)
    # names as holding a switch can hold one, such as a `CallNode`, a
    # `StringNode`, or a `DefNode`. A node of any other kind, such as a
    # `ClassNode`, an `UnlessNode`, a `MatchLastLineNode`, or a kind that a
    # later Prism adds, can't, so the switch moves out to the nearest
    # enclosing node that can. A kind left off the list costs a coarser
    # switch, where a kind wrongly on it would make code that means
    # something else.
    #
    # A node of a listed kind still can't hold a switch where parentheses
    # around it either don't parse or change what the code means. From the
    # placement table, that is true of:
    #
    # - a word of a `%w[]`, `%i[]`, `%W[]`, or `%I[]` array;
    # - a name in `alias` or `undef`, such as `g` in `alias g f`;
    # - an `elsif`, which Prism makes an `IfNode` inside its `if`;
    # - a label key in a hash, such as `a:`;
    # - a part of an interpolated or adjacent string, symbol, or regexp,
    #   such as `"a"` in `"a" "b"`;
    # - a regexp with named captures on the left of `=~`, and that `=~`
    #   call, so the switch goes on the whole match;
    # - the bare right side of an assignment, such as `1, 2` in
    #   `a, b = 1, 2`.
    module Holder
      # Whether `node` can hold a switch, given where it stands.
      #
      # - `node`: Prism::node, the node.
      # - `parent`: Prism::node, its parent, or nil at the root.
      # - `grandparent`: Prism::node, its grandparent, or nil.
      def self.holds?: (Prism::node node, Prism::node? parent, Prism::node? grandparent) -> bool

      KINDS: Array[singleton(Prism::Node)]
      COMPOUNDS: Array[singleton(Prism::Node)]

      def self.part?: (Prism::node node, Prism::node? parent) -> bool

      def self.label?: (Prism::node node) -> bool

      def self.matched_with_captures?: (Prism::node node, Prism::node? parent, Prism::node? grandparent) -> bool

      def self.bare_array?: (Prism::node node) -> bool
    end
  end
end
