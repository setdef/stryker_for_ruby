module Stryker
  class Instrumenter
    # The two pipes to a parse worker: the one to its standard input, which
    # takes a line at a time, and the one from its standard output. It
    # tells whether the worker took a line, and closes both pipes even when
    # the worker has ended.
    class ParseWorkerPipes
      # Raised by `read` when its time is up before a whole line has come.
      class DeadlinePassed < StandardError
      end

      # Prepares to use two pipes that are open.
      #
      # - `input`: IO, the pipe to the worker's standard input.
      # - `output`: IO, the pipe from its standard output.
      def initialize: (IO input, IO output) -> void

      # Writes `line` and a line feed. Gives false when the worker has ended
      # or the pipe is closed, and true otherwise.
      #
      # - `line`: String, what to write.
      def write: (String line) -> bool

      # The next line from the worker, with its line feed, or nil when the
      # worker has ended and the pipe holds nothing more. A carriage return
      # before the line feed, which Windows adds, is dropped. Waits until
      # there is a whole line, and raises `DeadlinePassed` when `seconds`
      # pass first, even when the worker has written the start of a line.
      #
      # - `seconds`: Float, how long to wait.
      def read: (Float seconds) -> String?

      # Closes both pipes. A line that the worker never read, which Windows
      # reports as `Errno::EPIPE` when the pipe closes, raises nothing.
      def close: () -> void

      private

      CHUNK: Integer

      @input: IO
      @output: IO
      @buffer: String
      @ended: bool

      def take: () -> String?
      def fill: (ParseDeadline deadline) -> void
      def close_input: () -> void
    end
  end
end
