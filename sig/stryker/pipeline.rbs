module Stryker
  # The stages of a run after Configure, composed as
  # [the pipeline](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/contributors/design/architecture.md#the-pipeline)
  # describes them, and the owner of what a run starts. It holds no code for
  # a particular system or report format: it is given the isolation
  # adapters and the reporters.
  #
  # `call` finds the files that `mutate` selects, finds their mutants and
  # instruments them, writes the instrumented source to a cache in a
  # temporary directory of its own, starts both isolation adapters, runs the
  # dry run, plans each mutant, runs the runtime mutants' runs through one
  # adapter and the static mutants' runs through the other, and stops both
  # adapters. It hands each domain event to every reporter as it happens,
  # and returns the run's mutation score.
  #
  # The cache and every process exist only while `call` runs, however it
  # ends: when it returns, when a stage raises, and when a signal such as
  # INT or TERM raises `SignalException` in it, it stops both adapters,
  # which end every process they started, and deletes the cache before the
  # exception leaves. A second signal during that cleanup ends it. Once the
  # cleanup is done, and before the exception leaves, it hands every reporter
  # `Stryker::Events::RunAborted`, so a reporter can end what it has drawn
  # before the command writes the error. It does so for any exception that
  # a stage raises, and for one that a reporter raises as it hears
  # `Stryker::Events::RunCompleted`. The exception that leaves is the run's
  # own, never one that a reporter raised as it heard
  # `Stryker::Events::RunAborted`.
  #
  # ## Examples
  #
  # ```ruby
  # isolations = ->(cache) { [Stryker::Isolation::ForkPerRun.new(cache, root), Stryker::Isolation::FreshProcesses.new(cache, root)] }
  # reporters = [Stryker::Reporters::JsonReport.new(config:, root:)]
  # Stryker::Pipeline.new(root, isolations, reporters).call(config)
  # # => 83.33333333333333
  # ```
  class Pipeline
    # What starts the name of the cache's directory. Private.
    CACHE: String

    # The line `nothing_tested` writes. Private.
    NOTHING_TESTED: String

    @root: String

    @isolations: ^(String cache) -> [_DryRunIsolation, _Isolation]

    @warnings: _Warnings

    @broadcast: Broadcast

    # Builds the pipeline.
    #
    # - `root`: String, the project's root.
    # - `isolations`: responds to `call(cache)`, with the cache's
    #   directory, and returns the two isolation adapters that read it,
    #   neither started: the one that runs the dry run and the runtime
    #   mutants' runs, and the one that runs the static mutants' runs.
    # - `reporters`: Array of Stryker::_Reporter, which receive every event.
    # - `warnings`: Stryker::_Warnings, where a stage writes a warning, such
    #   as the instrumentation's warning about a site that a mutator can't
    #   read, and the line that says a run tested no mutant. By default,
    #   `$stderr`.
    def initialize: (String root, ^(String cache) -> [_DryRunIsolation, _Isolation] isolations, Array[_Reporter] reporters, ?warnings: _Warnings) -> void

    # Runs mutation testing as `config` says, and returns the mutation score
    # of every mutant, as Stryker::Metrics gives it, or nil when no mutant
    # was valid, or when the dry run found no test and
    # `Stryker::Config#allow_empty` is true: such a run tests no mutant and
    # hands the reporters no `Stryker::Events::RunCompleted`. It writes one
    # line to `warnings` that says so. Raises what a stage raises, such as
    # Stryker::UnsupportedError for an ERB template, for a file that the
    # `json` reporter can't name, and
    # `Stryker::Isolation::DryRunError` for a dry run that failed, after it
    # has stopped every process and deleted the cache.
    #
    # - `config`: Stryker::Config, the checked options of the run.
    def call: (Config config) -> Float?

    # Ends the run as one that tested its mutants, as an outcome tells it to:
    # hands every reporter `Stryker::Events::RunCompleted` with the results.
    #
    # - `results`: Array of Stryker::MutantResult, the result of every
    #   mutant, in the order of the mutants' IDs. Empty when the run has no
    #   mutant.
    def completed: (Array[MutantResult] results) -> void

    # Ends the run as one that tested no mutant, as an outcome tells it to:
    # writes one line to `warnings` that says why, and tells no reporter, as
    # StrykerJS reports no mutant result.
    def nothing_tested: () -> void

    private

    # Finds the mutants of the files that `config` selects, tests them, and
    # returns what the trial came to.
    def run_stages: (Config config) -> Outcome::_Told

    # Does nothing when `error` is nil. Otherwise hands every reporter
    # `Stryker::Events::RunAborted` with `error`, and raises `error` again,
    # whatever a reporter raises as it hears the event.
    def aborted: (Exception? error) -> void

    # Finds the mutants of the files that `config` selects, and instruments
    # them, with the warnings going to the stream the pipeline was given.
    # Raises Stryker::UnsupportedError first for a file that a reporter can't
    # name, as Stryker::Pipeline::SelectedFiles says.
    def instrument: (Config config) -> Instrumentation::Result

    # Writes the cache, and tests the mutants with the adapters for it.
    def tested: (Config config, String cache, Instrumentation::Result instrumented) -> Outcome::_Told
  end
end
