module Stryker
  # A stretch of a source file, given by byte offsets from the start of the
  # file: the first byte in it, and the byte just after it. Prism's
  # `Prism::Location` is one.
  interface _Span
    # The offset of the first byte in the stretch.
    def start_offset: () -> Integer

    # The offset of the byte just after the stretch.
    def end_offset: () -> Integer
  end

  # One change to a source file, of the kind a programmer could make by
  # mistake. A run inserts each mutant into the code and runs the tests that
  # reach it, to learn whether any of them fails.
  #
  # A mutator returns each mutant as a text edit on the original source: the
  # bytes from `start_offset` up to `end_offset` give way to `replacement`.
  # The offsets count bytes from the start of the file, as Prism's do, not
  # characters, so a file with multibyte characters has offsets larger than
  # its character indexes. When `start_offset` equals `end_offset`, the edit
  # inserts `replacement` and removes nothing. When `replacement` is empty,
  # the edit removes the bytes and inserts nothing.
  #
  # A mutant is a value: two mutants with equal members are equal. It checks
  # none of its members against the file. It converts to and from JSON, as
  # `Stryker::JsonValue` says.
  #
  # ## Examples
  #
  # A mutant that turns the `+` of `total = a + b` into a `-`, in a file
  # whose first line this is:
  #
  # ```ruby
  # Stryker::Mutant.new(
  #   id: 7,
  #   file: "lib/invoice.rb",
  #   mutator_name: "ArithmeticOperator",
  #   start_offset: 10,
  #   end_offset: 11,
  #   replacement: "-"
  # )
  # ```
  class Mutant < Data
    include JsonValue
    extend JsonValue::Reading[Mutant]

    # The mutant's ID, unique in the run.
    attr_reader id: Integer

    # The path of the file the mutant changes. It crosses JSON as its bytes
    # and its encoding's name.
    attr_reader file: String

    # The name of the mutator that made the mutant, in the naming scheme that
    # the Stryker tools share, such as `"ArithmeticOperator"`.
    attr_reader mutator_name: String

    # The offset, in bytes from the start of the file, of the first byte the
    # edit replaces.
    attr_reader start_offset: Integer

    # The offset, in bytes from the start of the file, of the byte just after
    # the last one the edit replaces.
    attr_reader end_offset: Integer

    # The text that takes the place of the replaced bytes. It crosses JSON
    # as its bytes and its encoding's name, because it keeps the encoding of
    # the source, which can be any, or hold bytes that no encoding accepts.
    attr_reader replacement: String

    # The names of the members that cross JSON as their bytes and their
    # encoding's name: `file` and `replacement`. `mutator_name` holds a name,
    # so it doesn't.
    def self.byte_members: () -> Array[Symbol]

    # Builds the mutant.
    #
    # - `id`: Integer, the mutant's ID, unique in the run.
    # - `file`: String, the path of the file the mutant changes.
    # - `mutator_name`: String, the name of the mutator that made the mutant.
    # - `start_offset`: Integer, the offset of the first byte the edit
    #   replaces.
    # - `end_offset`: Integer, the offset of the byte just after the last one
    #   the edit replaces.
    # - `replacement`: String, the text that takes the place of those bytes.
    def self.new: (id: Integer, file: String, mutator_name: String, start_offset: Integer, end_offset: Integer, replacement: String) -> instance
                | (Integer id, String file, String mutator_name, Integer start_offset, Integer end_offset, String replacement) -> instance

    # `text` with the edit applied, as binary. `text` is a stretch of the
    # file that starts at byte `offset` and holds the whole edit, or the
    # whole file when `offset` is 0. The result is wrong, with no error, when
    # the edit lies outside `text`.
    #
    # - `text`: String, a stretch of the file.
    # - `offset`: Integer, the offset in the file of the first byte of `text`.
    #
    # ```ruby
    # mutant = Stryker::Mutant.new(id: 7, file: "lib/invoice.rb", mutator_name: "ArithmeticOperator",
    #                              start_offset: 10, end_offset: 11, replacement: "-")
    # mutant.edit("total = a + b\n")
    # # => "total = a - b\n"
    # mutant.edit("a + b", 8)
    # # => "a - b"
    # ```
    def edit: (String text, ?Integer offset) -> String

    # Whether the whole edit lies inside `span`. An edit that inserts at
    # either end of `span` lies inside it.
    #
    # - `span`: Stryker::_Span, a stretch of the file.
    def inside?: (_Span span) -> bool

    # Whether the edit replaces all of `span`.
    #
    # - `span`: Stryker::_Span, a stretch of the file.
    def covers?: (_Span span) -> bool
  end
end
