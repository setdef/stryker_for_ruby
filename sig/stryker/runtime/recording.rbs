module Stryker
  module Runtime
    # The holder for a run with no mutant active, such as the dry run, or
    # the fork parent while it loads the project's code: it holds no ID, and
    # records each hit.
    #
    # A hit in the main Ractor goes to `Stryker::Runtime::RECORDER`. A hit
    # in another Ractor goes to the holder's collector, which has to be
    # shareable for that Ractor to reach it. With no collector, such a hit
    # raises `Stryker::UnsupportedError`, so the test that made it fails
    # instead of losing the hit.
    #
    # Make the holder shareable before a constant holds it, as
    # `Stryker::Runtime.activate` does.
    #
    # ## Examples
    #
    # ```ruby
    # holder = Stryker::Runtime::Recording.new
    # holder.id
    # # => nil
    # holder.hit(7, 8)
    # # => nil
    # Stryker::Runtime::RECORDER.static.include?(8)
    # # => true
    # Ractor.new { Stryker::Runtime::Recording.new.hit(7) }.value
    # # => raises Ractor::RemoteError, caused by Stryker::UnsupportedError
    # ```
    class Recording < Data
      # Where a hit in a Ractor other than the main one goes, such as a
      # Ractor that collects hits.
      interface _Inbox
        # Takes one hit: the IDs of the mutants at one switch.
        def <<: (Array[Integer] ids) -> void
      end

      # The message of the `Stryker::UnsupportedError` that a hit in a
      # Ractor other than the main one raises when the holder has no
      # collector.
      OUTSIDE_THE_MAIN_RACTOR: String

      # Where a hit in a Ractor other than the main one goes, or nil when
      # such a hit raises.
      attr_reader collector: _Inbox?

      # Builds the holder.
      #
      # - `collector`: Stryker::Runtime::Recording::_Inbox, where a hit in a
      #   Ractor other than the main one goes, or nil, the default.
      def self.new: (?collector: _Inbox?) -> instance
                  | (_Inbox? collector) -> instance

      # Builds the holder, as `Stryker::Runtime::Recording.new` does.
      def initialize: (?collector: _Inbox?) -> void

      # Always nil: no mutant is active.
      def id: () -> nil

      # Records a hit for the mutants with `ids`, from the Ractor that runs
      # it, as `deliver` does. Returns nil.
      #
      # - `ids`: Integer, each mutant's ID.
      def hit: (*Integer ids) -> nil

      # Records a hit for the mutants with `ids`, made in `ractor`. A hit
      # in the main Ractor goes to `Stryker::Runtime::RECORDER`. A hit in
      # any other goes to the collector, or raises
      # `Stryker::UnsupportedError` when there is none. Returns nil.
      #
      # `hit` passes the Ractor that runs it. Pass another only to test the
      # route a hit takes.
      #
      # - `ids`: Array of Integer, the mutants' IDs.
      # - `ractor`: Ractor, where the hit was made.
      def deliver: (Array[Integer] ids, Ractor ractor) -> nil

      private

      def forward: (Array[Integer] ids) -> void
    end
  end
end
