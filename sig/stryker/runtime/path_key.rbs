module Stryker
  module Runtime
    # The form of a path that the loader and the stack check compare, as
    # [Paths on Windows](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/contributors/design/loading-and-isolation.md#paths-on-windows)
    # specifies. Two spellings of one file on Windows have the same key, so
    # the loader's hook, the loading check, and the stack check treat them
    # as one file.
    #
    # ## Examples
    #
    # ```ruby
    # Stryker::Runtime::PathKey.of("C:\\App\\Lib\\Invoice.rb", "\\")
    # # => "c:/app/lib/invoice.rb"
    # Stryker::Runtime::PathKey.of("/app/lib/Invoice.rb", nil)
    # # => "/app/lib/Invoice.rb"
    # ```
    module PathKey
      # The keys of one file, as `of_file` gives them. It is Enumerable over
      # the keys that exist, `given` first, so a caller that only needs every
      # key iterates it.
      class Keys < Data
        include Enumerable[String]

        # The key of the path as it was given.
        attr_reader given: String

        # The key of the path's real path, or nil when the path is relative
        # or no file is at it.
        attr_reader real: String?

        # Builds the keys of one file.
        #
        # - `given`: String, the key of the path as given.
        # - `real`: String or nil, the key of the real path.
        def self.new: (given: String, real: String?) -> instance
                    | (String given, String? real) -> instance

        # Yields the key of the path as given, and then the key of its real
        # path when there is one.
        def each: () { (String key) -> void } -> void

        # The key of the real path when there is one, and otherwise the key of
        # the path as given.
        def resolved: () -> String

        # A Hash from each key to `file`: the keys of one file, each
        # pointing at it.
        #
        # - `file`: String, what each key maps to.
        def to: (String file) -> Hash[String, String]
      end
      # The key of `path`. With a `separator`, each `separator` in it becomes
      # `/`, and every letter is lowercased, as on Windows, where Ruby can
      # give one file with another drive letter, letter case, or separator.
      # With none, the letters keep their case, because a case-sensitive file
      # system has files that differ only in case. The key has the bytes of
      # `path`, tagged UTF-8 whatever encoding Ruby tagged `path` with: under
      # the C locale Ruby tags a path from the file system US-ASCII, and a
      # Hash finds a key only in the same encoding. It resolves no symbolic
      # link and no `..`, and reads nothing from disk.
      #
      # - `path`: String, a file's path.
      # - `separator`: String or nil, the system's alternative path
      #   separator, `File::ALT_SEPARATOR` by default: a backslash on
      #   Windows, and nil elsewhere.
      def self.of: (String path, ?String? separator) -> String

      # The `Keys` of the two paths that can name the file at `path`: `path`
      # itself (`given`), and its real path (`real`), with every symbolic link
      # and `..` resolved. Ruby gives the loader's hook a path that can hold either,
      # and gives a file that Ruby or Bootsnap compiles its real path, in the
      # file's frames and in `$LOADED_FEATURES`. A file that the hook
      # compiles shows the path the hook received. When no file is at
      # `path`, or `path` is relative, `real` is nil. It reads
      # the disk once, to resolve the real path.
      #
      # - `path`: String, a file's path.
      # - `separator`: String or nil, as `of` takes it.
      #
      # ```ruby
      # Stryker::Runtime::PathKey.of_file("/var/app/lib/invoice.rb").to_a
      # # => ["/var/app/lib/invoice.rb", "/private/var/app/lib/invoice.rb"], on macOS
      # Stryker::Runtime::PathKey.of_file("C:\\App\\Lib\\Invoice.rb", "\\").to_a
      # # => ["c:/app/lib/invoice.rb"], when no file is there
      # ```
      def self.of_file: (String path, ?String? separator) -> Keys

      # The absolute form of `path`, a path that Ruby gave the loader's hook.
      # A load that Ruby finds relative to the working directory gives the
      # hook the path as it was written, such as `line.rb`, and Ruby resolves
      # it against the working directory when it opens the file. An absolute
      # path is returned as it is, with its symbolic links and `..` in place,
      # so that `real` resolves them. The loading check doesn't use this,
      # because a built-in feature such as `thread.rb` is a name and no path.
      # It reads the working directory's name from the system, and no file.
      #
      # - `path`: String, a path as Ruby gave it to the hook.
      def self.located: (String path) -> String

      # The base name of `key`, a key that `of` made, with letter case folded
      # on every system, because a file system can fold it whatever the
      # platform's convention: the default macOS file system does. `key` has
      # `/` between its parts, so the base name is what follows the last one.
      # A byte that isn't valid UTF-8 becomes U+FFFD first, because Ruby
      # raises `ArgumentError` when it folds a string with such a byte, and
      # the hook calls this for every file that Ruby loads. It reads nothing
      # from disk.
      #
      # - `key`: String, the key of a file's path.
      def self.name: (String key) -> String

      # The base name of each of `keys`, with letter case folded, as `name`
      # gives it.
      #
      # - `keys`: Array of String, keys that `of` made.
      def self.names: (Array[String] keys) -> Set[String]

      # The real path of the file at `path`, with every symbolic link and `..`
      # resolved, or nil when `path` is relative or no file is at `path`. A
      # relative path is never resolved against the current directory,
      # because Ruby lists a built-in feature such as `thread.rb` by its bare
      # name, and a project can have a file of that name. It reads the disk
      # once, for an absolute path.
      # Ruby shows a file's real path as its absolute path, so the loader
      # compiles a file it serves under this path.
      #
      # - `path`: String, a file's path.
      def self.real: (String path) -> String?
    end
  end
end
