module Stryker
  module Runtime
    # The collector of a process that records hits, as
    # [Ractors](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/design/coverage.md#ractors)
    # specifies. A Ractor other than the main one can't reach the recorder,
    # so a holder there sends each message to the collector, whose Ractor
    # keeps it until the recorder drains it.
    #
    # A collector is built with no Ractor. Its Ractor starts at the project's
    # first `Ractor.new`, which Stryker::Runtime::FirstRactor catches, so a
    # project that makes no Ractor gets none from the runtime. The collector
    # is a Module, so it is shareable and a frozen holder can hold it, and
    # it still takes its Ractor once that starts. The recorder drains it in
    # the main Ractor, which owns its reply port.
    #
    # ## Examples
    #
    # ```ruby
    # collector = Stryker::Runtime::Collector.new
    # Stryker::Runtime::RECORDER.collect_from(collector)
    # collector.started?
    # # => false
    # Ractor.new(collector) { |inbox| 3.times { inbox << [7] } }.join
    # collector.started?
    # # => true
    # collector.drain
    # # => [[7]]
    # collector.drain
    # # => []
    # ```
    class Collector < Module
      # What the collector's Ractor runs: it receives each message from
      # `inbox` and keeps it, and on a drain sends what it kept since the
      # last drain to `reply`: each path once, in the order the paths
      # arrived, and then one Array of every mutant ID that a hit named,
      # with no ID twice, or no Array when no hit came. It keeps one entry
      # per mutant and per file, however many hits arrive. It returns
      # only when `inbox` raises StopIteration, as a stand-in in a test does.
      # It is internal to the runtime, and public so that a test in the main
      # Ractor can run it, because coverage counts no line that another
      # Ractor runs.
      #
      # - `inbox`: Ractor, whose `receive` gives the next message.
      # - `reply`: Ractor::Port, where a drain's messages go.
      def self.serve: (singleton(Ractor) inbox, Ractor::Port[Array[message]] reply) -> void

      private def self.batch: (singleton(Ractor) inbox, Set[Integer] ids, Set[String] paths) -> Array[message]

      # Builds a collector with no Ractor. It starts none, and says nothing.
      def initialize: () -> void

      # Gives the collector its Ractor, which runs `serve`, and the port the
      # Ractor answers on. Stryker::Runtime::FirstRactor calls it at the
      # project's first `Ractor.new`. Returns the collector.
      #
      # - `ractor`: Ractor, the collector's Ractor.
      # - `reply`: Ractor::Port, owned by the main Ractor.
      def started: (Ractor ractor, Ractor::Port[Array[message]]? reply) -> self

      # Whether the collector has its Ractor.
      def started?: () -> bool

      # The collector, when it has no Ractor yet, or nil.
      def unstarted: () -> self?

      # Sends `message` to the collector's Ractor, from any Ractor, and
      # returns the collector. Raises Ractor::ClosedError when that Ractor
      # has ended, as one started before a fork has in the child. Raises
      # `Stryker::UnsupportedError` when the collector has no Ractor, which
      # happens only for a Ractor that started before the runtime loaded.
      #
      # - `message`: Array of Integer or String, a hit's IDs or a path.
      def <<: (message message) -> self

      # What was sent to the collector since the last drain, as `serve`
      # gives it, or an empty Array when it has no Ractor. It waits until the Ractor answers, so every message whose
      # send finished before the call is in it. Call it only from the main
      # Ractor.
      def drain: () -> Array[message]

      DRAIN: :drain

      NOT_STARTED: String

      private

      @ractor: Ractor?
      @reply: Ractor::Port[Array[message]]?
    end
  end
end
