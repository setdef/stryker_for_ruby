module Stryker
  module Runtime
    # The table that the loader's hook searches for the cache file that holds
    # a path's instrumented source, as
    # [Finding an instrumented file](https://github.com/setdef/stryker_for_ruby/blob/trunk/docs/contributors/design/loading-and-isolation.md#finding-an-instrumented-file)
    # specifies. `Stryker::Runtime::Cache.read` builds it from the cache's
    # index. It is shareable, so the hook reads it in any Ractor.
    #
    # The table owns the rule that a file has two keys: the key of its path as
    # given, and the key of its real path, with every symbolic link and `..`
    # resolved (`Stryker::Runtime::PathKey.of_file`). It builds the keys
    # and the base names from the files it is given, and answers whether a
    # path is instrumented, so no caller reads or builds them.
    #
    # ## Examples
    #
    # ```ruby
    # table = Stryker::Runtime::LookupTable.of({ "/app/lib/invoice.rb" => "/tmp/cache/0.rb" }, nil)
    # table.file("/app/lib/invoice.rb")
    # # => "/tmp/cache/0.rb"
    # table.file("/app/lib/receipt.rb")
    # # => nil
    # table.instrumented?("/app/lib/invoice.rb")
    # # => true
    # ```
    class LookupTable < Data
      # Each key of each instrumented file, as
      # `Stryker::Runtime::PathKey.of_file` gives them with `separator`, and
      # the file in the cache that holds its instrumented source. Only the
      # table reads it.
      attr_reader files: Hash[String, String]

      # The base name of each key in `files`, with letter case folded
      # (`Stryker::Runtime::PathKey.names`). `file` resolves the real path of
      # a file that it can't find only when the file's base name is here.
      # Only the table reads it.
      attr_reader names: Set[String]

      # The alternative path separator that the keys were made with, or nil.
      attr_reader separator: String?

      private def self.new: (files: Hash[String, String], names: Set[String], separator: String?) -> instance

      # The shareable table of `paths`: each path's keys, and the folded base
      # name of each key. It resolves the real path of each path once. Only
      # `of` builds a table, so `files` and `names` never disagree.
      #
      # - `paths`: Hash of String to String, from each instrumented file's
      #   path to the file in the cache that holds its instrumented source.
      #   A path can be in any encoding.
      # - `separator`: String or nil, the separator that makes the keys, as
      #   `Stryker::Runtime::PathKey.of` takes it.
      def self.of: (Hash[String, String] paths, String? separator) -> LookupTable

      # The file in the cache that holds the instrumented source of the file
      # at `path`, or nil when that file isn't instrumented. It compares
      # `path`'s key with the keys in the table, and reads nothing from disk,
      # so the hook pays only a Hash lookup for a file that Ruby loads.
      #
      # When the table has no such key, but the key's base name, with letter
      # case folded, is in `names`, it resolves the real path
      # (`Stryker::Runtime::PathKey.real`, of the path that
      # `Stryker::Runtime::PathKey.located` gives, so a path relative to the
      # working directory is resolved against it) and compares that key. A `load`
      # through a second symbolic link, or in another letter case on a file
      # system that folds it, gives a path that the table doesn't have, and
      # nothing in `$LOADED_FEATURES` shows the miss. The resolution costs a
      # system call, so a file with a base name that no instrumented file has
      # never pays for it. A file in another folder with the same base name as
      # an instrumented file does, and is then not instrumented.
      #
      # - `path`: String, a file's path, as Ruby gives it to the hook.
      def file: (String path) -> String?

      # Whether `path` is an instrumented file: `path`'s key, or the key of its
      # real path, is one of the table's keys. Unlike `file`, it resolves the
      # real path of every absolute `path`, whatever its base name, and it
      # never resolves a relative one, because the loading check gives it
      # `$LOADED_FEATURES`, where Ruby lists a built-in feature such as
      # `thread.rb` by its bare name. It reads the disk once. It tells nothing
      # about whether the hook served the file.
      #
      # - `path`: String, a file's path.
      def instrumented?: (String path) -> bool

      # The key of `path` as `Stryker::Runtime::PathKey.of` makes it with the
      # table's separator, the form in which the table compares `path` as
      # given. The loader records each file it serves under it. It reads
      # nothing from disk.
      #
      # - `path`: String, a file's path.
      def key: (String path) -> String

      private def resolved: (String path, String own) -> String?
    end
  end
end
