module Stryker
  module Runtime
    # The paths of the files in the cache that the loader's hook has served
    # in this process, as `Stryker::Runtime::PathKey.of` keys them, which
    # the loading check reads. Any thread of the main Ractor may call its
    # methods: it holds a lock while it reads or adds. A forked child
    # inherits what its parent served.
    #
    # ## Examples
    #
    # ```ruby
    # served = Stryker::Runtime::Served.new
    # served.add("/app/lib/invoice.rb")
    # served.include?("/app/lib/invoice.rb")
    # # => true
    # ```
    class Served
      # Builds a record of no files.
      def initialize: () -> void

      # Records that the hook served the file at `path`. Returns nil.
      #
      # - `path`: String, the path the hook was given, as a key.
      def add: (String path) -> nil

      # Whether the hook served a file under `path`.
      #
      # - `path`: String, a path as a key.
      def include?: (String path) -> bool

      private

      @lock: Thread::Mutex
      @files: Set[String]
    end
  end
end
