module Stryker
  module Runtime
    # The buckets of a Stryker::Runtime::Recorder: the static bucket, each
    # test's bucket, and which of them is current. The recorder holds its
    # lock around every call except `recorded?`, so a Buckets itself takes
    # none.
    #
    # ## Examples
    #
    # ```ruby
    # buckets = Stryker::Runtime::Buckets.new
    # buckets.record([1])
    # buckets.check_start("InvoiceTest#test_total")
    # buckets.start("InvoiceTest#test_total")
    # buckets.record([7])
    # buckets.check_finish
    # buckets.finish
    # buckets.tests
    # # => {"InvoiceTest#test_total" => #<Set: {7}>}
    # ```
    class Buckets
      # Builds the buckets with no hits and no tests.
      def initialize: () -> void

      # A copy of the static bucket.
      def static: () -> Set[Integer]

      # A copy of each test's bucket, by test, in the order the tests first
      # started.
      def tests: () -> Hash[Object, Set[Integer]]

      # The path of every file whose load began during a test, as a new Set.
      def loaded: () -> Set[String]

      # Raises RuntimeError, naming both tests, when another test is running,
      # and does nothing otherwise. Returns nil. The recorder calls it before
      # `start`, so that a refused start has drained nothing.
      #
      # - `test`: Object, the test.
      def check_start: (Object test) -> nil

      # Makes `test`'s bucket current: a new one, or the one it had when it
      # ran before. Returns nil. Call `check_start` first.
      #
      # - `test`: Object, the test.
      def start: (Object test) -> nil

      # Raises RuntimeError when no test is running, and does nothing
      # otherwise. Returns nil. The recorder calls it before `finish`.
      def check_finish: () -> nil

      # Makes the static bucket current. Returns nil. Call `check_finish`
      # first.
      def finish: () -> nil

      # Whether a hit for the mutants with `ids` would change nothing: every
      # one is in the current bucket, and no stack check is due for it.
      # Changes nothing.
      #
      # The recorder calls it without its lock, which is safe for three
      # reasons. Under the GVL, `Set#include?` and `Hash#[]` never see
      # another thread's change half made. A stale `false` only sends the
      # recorder to take its lock, where `record` merges the IDs again. A
      # stale `true` is for IDs that the bucket held when the method read it,
      # and a hit for them adds nothing. And the method reads the current
      # bucket once, so the whole answer comes from one bucket.
      #
      # - `ids`: Array of Integer, the mutants' IDs.
      def recorded?: (Array[Integer] ids) -> bool

      # Records a message that the collector drained: `record` for an Array
      # of IDs, or `load_began` for a path. Returns nil.
      #
      # - `message`: Array of Integer or String.
      def receive: (message message) -> nil

      # Records a hit for the mutants with `ids` in the current bucket, or in
      # the static bucket when it is a static hit. Returns nil.
      #
      # - `ids`: Array of Integer, the mutants' IDs.
      def record: (Array[Integer] ids) -> nil

      # Records that the file at `path` began to load, during the current
      # test. Between tests it records nothing. Returns nil.
      #
      # - `path`: String, the file's path.
      def load_began: (String path) -> nil

      NO_TEST_RUNNING: String

      private

      @static: Set[Integer]
      @runs: Hash[Object, TestRun]
      @current: TestRun?

      def overlap: (Object test) -> String
    end
  end
end
