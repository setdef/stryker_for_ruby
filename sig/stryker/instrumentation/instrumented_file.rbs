module Stryker
  class Instrumentation
    # What instrumenting one file gave.
    class InstrumentedFile < Data
      # What instrumenting the file at `path` with its live mutants gave: each
      # mutant that `result` skipped has no switch and a result that says
      # why: `CompileError` when it isn't valid Ruby, and `Ignored` when its
      # site can't hold a switch or its text has no form on one line. Each
      # ignored mutant of `made` has no switch either.
      #
      # - `path`: String, the file's absolute path.
      # - `made`: Stryker::Mutators::Made, the file's live mutants and the
      #   results of its ignored mutants, which have no switch and use IDs of
      #   the file's.
      # - `result`: Stryker::Instrumenter::Result, what the instrumenter gave
      #   for the live mutants.
      def self.of: (String path, Mutators::Made made, Instrumenter::Result result) -> InstrumentedFile

      # The ID of the first mutant of the file after `files`, which used the
      # IDs from 1 in turn.
      #
      # - `files`: Array of Stryker::Instrumentation::InstrumentedFile, the
      #   files instrumented so far.
      def self.next_id: (Array[InstrumentedFile] files) -> Integer

      # The file's absolute path.
      attr_reader path: String

      # The file's instrumented source.
      attr_reader source: String

      # The file's mutants that got a switch.
      attr_reader mutants: Array[Mutant]

      # The result of each of the file's mutants that got no switch: its
      # `CompileError` or `Ignored` status. The ignored mutants of the
      # file's excluded mutators come with them.
      attr_reader unrun: Array[MutantResult]

      # How many mutants the mutators made in the file, with or without a
      # switch, which is how many IDs the file used.
      attr_reader mutant_count: Integer

      # Builds the value.
      #
      # - `path`: String, the file's absolute path.
      # - `source`: String, its instrumented source.
      # - `mutants`: Array of Stryker::Mutant, its live mutants.
      # - `unrun`: Array of Stryker::MutantResult, its results for the mutants that got no switch.
      # - `mutant_count`: Integer, how many mutants the mutators made in it.
      def self.new: (path: String, source: String, mutants: Array[Mutant], unrun: Array[MutantResult], mutant_count: Integer) -> instance
                  | (String path, String source, Array[Mutant] mutants, Array[MutantResult] unrun, Integer mutant_count) -> instance
    end
  end
end
