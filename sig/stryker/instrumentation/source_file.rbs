module Stryker
  class Instrumentation
    # One file that Find files selected, on its way to the cache.
    class SourceFile
      @path: String

      @first_id: Integer

      @absolute: String

      # Builds the file.
      #
      # - `root`: String, the project's root.
      # - `path`: String, the file's path from the root.
      # - `first_id`: Integer, the ID of the file's first mutant.
      def initialize: (String root, String path, Integer first_id) -> void

      # Reads the file, finds its mutants with `mutators`, numbered from
      # the first ID, and instruments it with the parse workers of `pool`. A
      # mutant of a mutator that `policy` excludes is ignored and gets no
      # switch. The file's bytes are read as they are, tagged UTF-8, as Ruby
      # reads a source file. Each mutant names the file by its path from the
      # root.
      #
      # - `pool`: Stryker::Instrumenter::ParsePool, which parses the plain
      #   mutants.
      # - `mutators`: Array of Stryker::_Mutator, the mutators to run.
      # - `policy`: Stryker::Mutators::Policy, which mutators' mutants are
      #   ignored.
      def instrumented: (Instrumenter::ParsePool pool, Array[_Mutator] mutators, Mutators::Policy policy) -> InstrumentedFile
    end
  end
end
