#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'
set -vx

if command -v mise >/dev/null 2>&1; then
  mise install
  mise x -- bundle install
  mise x -- reuse download --all
  pre-commit install
  bundle exec rake rdoc
else
  echo "mise isn't installed. Please install it to continue." >&2
  exit 1
fi
