# RBS's core signatures give fork, spawn, and exit! to Kernel only, though
# Ruby defines them on Process too. These cover the calls the isolation
# adapters make.
module Process
  def self.fork: () { () -> void } -> Integer

  def self.exit!: (?Integer status) -> bot

  def self.spawn: (Hash[String, String?] env, *(String | Hash[Symbol | IO, IO | String | bool]) arguments) -> Integer
end
